<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>Modulix - Docker</AssemblyTitle>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Modulix - Docker</Title>
    <Authors>Max Meyer</Authors>
    <Product>Modulix</Product>
    <Description>Docker container management library for the Modulix framework.</Description>
    <RepositoryUrl>https://github.com/MaxMeyer-05/Modulix</RepositoryUrl>
    <Version>1.1.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="True" PackagePath="\" />
  </ItemGroup>

</Project>
