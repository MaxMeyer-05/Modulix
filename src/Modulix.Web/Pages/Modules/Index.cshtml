@page "/modules"
@using System.Globalization
@model IndexModel
@{
    ViewData["Title"] = "Modules";
    var modules = Model.Modules;
    var reopen = Model.CreationError is not null;
    var statuses = new (string Value, string Label)[]
    {
        ("", "All statuses"),
        ("Running", "Running"),
        ("Starting", "Starting"),
        ("Created", "Created"),
        ("PendingConfirmation", "Pending confirmation"),
        ("QueuedForScan", "Queued for scan"),
        ("Stopped", "Stopped"),
        ("Failed", "Failed")
    };
    var closeUrl = Url.Page("/Modules/Index");
    var autoRefresh = new PageAutoRefreshModel(Model.GetPageUrl(Model.CurrentPage));
}
@section Styles {
    <link rel="stylesheet" href="~/css/modules.css" asp-append-version="true" />
}

<div class="page modules-page" data-auto-refresh="300">
    <header class="page-header">
        <div class="page-header-main">
            <h1 class="page-title">Modules</h1>
            <p class="page-description">Browse and manage registered modules.</p>
        </div>
        <div class="page-header-actions">
            <button class="module-button module-button-primary" type="button" id="add-module-button" data-dialog-open="add-module-dialog">
                <i data-lucide="plus" aria-hidden="true"></i><span>Add module</span>
            </button>
        </div>
    </header>

    <form class="page-toolbar" method="get" action="@closeUrl">
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <div class="module-search-field">
            <i data-lucide="search" aria-hidden="true"></i>
            <input id="module-search" name="q" type="search" value="@Model.Query" placeholder="Search modules..." aria-label="Search modules" autocomplete="off" />
        </div>
        <label class="module-select-label"><span>Status</span>
            <select id="module-status-filter" name="status">
                @foreach (var (value, label) in statuses)
                {
                    <option value="@value" selected="@(Model.StatusFilter.Equals(value, StringComparison.OrdinalIgnoreCase))">@label</option>
                }
            </select>
        </label>
        <button class="module-button" type="submit"><i data-lucide="search" aria-hidden="true"></i><span>Apply</span></button>
        <partial name="_AutoRefresh" model="autoRefresh" />
    </form>

    <div class="page-content">
    @if (!ViewData.ModelState.IsValid)
    {
        <partial name="_ErrorState" model='new PageErrorStateModel("Module request failed") { ValidationSummary = ValidationSummary.All }' />
    }

    @if (Model.Feedback is { IsSuccess: false } feedback)
    {
        <partial name="_ErrorState" model='new PageErrorStateModel(feedback.Title) { Description = feedback.Description }' />
    }

    @if (ViewData.ModelState.IsValid)
    {
        <p class="module-result-count" id="module-result-count" role="status">@(modules.Count == Model.TotalModules ? $"{modules.Count} modules" : $"{modules.Count} of {Model.TotalModules} modules (page {Model.CurrentPage} of {Model.TotalPages})")</p>
    }
    <div class="module-card-grid" id="module-card-grid">
        @foreach (var module in modules)
        {
            <a class="module-card" asp-page="/Modules/Detail" asp-route-id="@module.Id">
                <div class="module-card-heading">
                    <span class="module-symbol"><i data-lucide="box" aria-hidden="true"></i></span>
                    <h2>@module.ModuleName</h2>
                    <span class="module-badge badge-@ModuleStatusDisplay.StatusClass(module.Status)"><span aria-hidden="true"></span>@ModuleStatusDisplay.StatusLabel(module.Status)</span>
                    <i class="module-card-arrow" data-lucide="arrow-up-right" aria-hidden="true"></i>
                </div>
                <p class="module-description @(string.IsNullOrWhiteSpace(module.Description) ? "module-description-empty" : "")">@(string.IsNullOrWhiteSpace(module.Description) ? "No description provided." : module.Description)</p>
                <dl class="module-card-facts">
                    <div><dt>Base path</dt><dd class="module-code">@module.BaseUrlPath</dd></div>
                    <div><dt>Port</dt><dd>@module.ContainerPort</dd></div>
                    <div><dt>Created</dt><dd>@module.CreatedAtUtc.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</dd></div>
                </dl>
                <div class="module-card-footer"><span>Module ID</span><span class="module-code">@module.Id</span></div>
            </a>
        }
    </div>
    @if (modules.Count == 0 && ViewData.ModelState.IsValid)
    {
        <partial name="_EmptyState" model='new PageEmptyStateModel("No modules found", "search-x") {
            Id = "module-no-results",
            Description = "No modules match your search and filters.",
            ActionText = "Reset filters",
            ActionUrl = closeUrl,
            ActionIcon = "rotate-ccw"
        }' />
    }
    @if (Model.TotalModules > 0)
    {
        var startPage = Math.Max(1, Model.CurrentPage - 2);
        var endPage = Math.Min(Model.TotalPages, startPage + 4);
        startPage = Math.Max(1, endPage - 4);
        <footer class="module-pagination-bar" aria-label="Modules pagination">
            <form class="module-pagination-size" method="get" action="@closeUrl">
                @if (!string.IsNullOrWhiteSpace(Model.Query))
                {
                    <input type="hidden" name="q" value="@Model.Query" />
                }
                @if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
                {
                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                }
                <input type="hidden" name="page" value="1" />
                <label class="module-pagination-size-label" for="modules-page-size">
                    <span>Rows per page</span>
                    <select id="modules-page-size" name="pageSize" data-page-size-select>
                        @foreach (var size in IndexModel.AllowedPageSizes)
                        {
                            <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                        }
                    </select>
                </label>
                <span class="module-pagination-summary">Page @Model.CurrentPage of @Model.TotalPages (@Model.TotalModules total)</span>
            </form>
            <nav class="module-pagination-controls" aria-label="Modules page navigation">
                @if (Model.HasPreviousPage)
                {
                    <a class="module-button module-button-compact" href="@Model.GetPageUrl(Model.CurrentPage - 1)" aria-label="Previous page">
                        <i data-lucide="chevron-left" aria-hidden="true"></i><span>Previous</span>
                    </a>
                }
                @for (var p = startPage; p <= endPage; p++)
                {
                    if (p == Model.CurrentPage)
                    {
                        <span class="module-button module-button-compact module-button-primary" aria-current="page">@p</span>
                    }
                    else
                    {
                        <a class="module-button module-button-compact" href="@Model.GetPageUrl(p)" aria-label="Page @p">@p</a>
                    }
                }
                @if (Model.HasNextPage)
                {
                    <a class="module-button module-button-compact" href="@Model.GetPageUrl(Model.CurrentPage + 1)" aria-label="Next page">
                        <span>Next</span><i data-lucide="chevron-right" aria-hidden="true"></i>
                    </a>
                }
            </nav>
        </footer>
    }

    <dialog class="dialog dialog--md" id="add-module-dialog" data-open-on-load="@(reopen ? "true" : "false")" closedby="closerequest" aria-labelledby="add-module-heading">
        <div class="dialog-header">
            <span class="dialog-icon" aria-hidden="true"><i data-lucide="box"></i></span>
            <div class="dialog-heading">
                <h2 class="dialog-title" id="add-module-heading">Add module</h2>
                <p class="dialog-subtitle">Configure the module and upload its archive.</p>
            </div>
            <button class="ui-icon-button" type="button" data-dialog-close aria-label="Close" title="Close"><i data-lucide="x" aria-hidden="true"></i></button>
        </div>
        <form class="dialog-layout" id="add-module-form" method="post" asp-page="/Modules/Index" enctype="multipart/form-data" data-submit-label="Uploading..." data-field-errors="@System.Text.Json.JsonSerializer.Serialize(Model.CreationFieldErrors)">
            <div class="dialog-body">
                @if (Model.CreationError is { } error)
                {
                    <div class="module-form-error" role="alert">
                        <strong>@error.Title</strong> <span class="module-code">HTTP @error.StatusCode</span>
                        <p>@error.Description</p>
                    </div>
                }
                <fieldset class="module-form-fields" id="module-creation-fields">
                    <div class="module-form-row">
                        <label><span>Module name <span class="required-mark">*</span></span><input name="ModuleName" value="@Model.Input?.ModuleName" required maxlength="100" placeholder="AnalyticsModule" autofocus /></label>
                        <label><span>Version <span class="required-mark">*</span></span><input name="Version" value="@(Model.Input?.Version ?? "v1.0.0")" required maxlength="50" placeholder="v1.0.0" /></label>
                    </div>
                    <label>Description<textarea name="Description" rows="2" maxlength="500" placeholder="Optional description">@Model.Input?.Description</textarea></label>
                    <label>Changelog<textarea name="Changelog" rows="2" maxlength="500" placeholder="Optional changelog for the initial version">@Model.Input?.Changelog</textarea></label>
                    <div class="module-form-row">
                        <label><span>Base URL path <span class="required-mark">*</span></span><input name="BaseUrlPath" value="@Model.Input?.BaseUrlPath" required maxlength="200" placeholder="module/analytics" /></label>
                        <label>Container port<input name="ContainerPort" value="@Model.Input?.ContainerPort" type="number" min="1" max="65535" placeholder="Automatic" /></label>
                    </div>
                    <div class="module-subendpoints-group">
                        <div class="module-subendpoints-header">
                            <div>
                                <span class="module-field-label">Sub-endpoints <span class="module-optional-label">(optional)</span></span>
                                <p class="module-field-hint">Pre-register expected HTTP routes to compare against the scanner result.</p>
                            </div>
                            <button class="module-button module-button-compact" type="button" id="add-subendpoint-button">
                                <i data-lucide="plus" aria-hidden="true"></i><span>Add endpoint</span>
                            </button>
                        </div>
                        <div class="module-subendpoints-list" id="initial-endpoints-list">
                            @if (Model.Input?.InitialEndpoints is not null)
                            {
                                var idx = 0;
                                foreach (var ep in Model.Input.InitialEndpoints)
                                {
                                    var currentMethod = (ep.HttpMethod ?? "GET").ToUpperInvariant();
                                    <div class="module-subendpoint-row" data-subendpoint-row>
                                        <select name="InitialEndpoints[@idx].HttpMethod" aria-label="HTTP method">
                                            @foreach (var httpMethod in new[] { "GET", "POST", "PUT", "PATCH", "DELETE" })
                                            {
                                                <option value="@httpMethod" selected="@(currentMethod == httpMethod)">@httpMethod</option>
                                            }
                                        </select>
                                        <input name="InitialEndpoints[@idx].EndpointPath" value="@ep.EndpointPath" required maxlength="200" placeholder="/api/v1/items" aria-label="Endpoint path" />
                                        <button class="module-icon-button module-subendpoint-remove" type="button" data-remove-subendpoint aria-label="Remove endpoint" title="Remove endpoint">
                                            <i data-lucide="trash-2" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    idx++;
                                }
                            }
                        </div>
                    </div>
                    <span class="module-field-label">Module archive <span class="required-mark">*</span></span>
                    <label class="module-upload" id="module-upload-area" for="module-archive" data-file-upload>
                        <i data-lucide="upload" aria-hidden="true"></i>
                        <strong>Choose a ZIP archive</strong>
                        <span class="module-field-hint">Or drag and drop one ZIP archive here.</span>
                        <span class="module-upload-file" data-file-details role="status">No file selected</span>
                        <input id="module-archive" name="ModuleFile" type="file" accept=".zip,application/zip" aria-label="Module archive" required />
                    </label>
                    @if (Model.CreationError is not null)
                    {
                        <p class="module-field-hint">For security, select the archive again after a failed submission.</p>
                    }
                </fieldset>
            </div>
            <div class="dialog-footer">
                <button class="ui-button" type="button" data-dialog-close>Cancel</button>
                <button class="ui-button ui-button-primary" type="submit"><i data-lucide="plus" aria-hidden="true"></i><span>Create</span></button>
            </div>
        </form>
    </dialog>

    @if (Model.CreationSuccess is { } success)
    {
        var hasDiscrepancy = success.DiscrepancyReport is { HasDiscrepancy: true };
        var resultVariant = success.Kind switch
        {
            "error" => "danger",
            "accepted" => "info",
            _ when hasDiscrepancy => "info",
            _ => "success"
        };
        var resultIcon = resultVariant switch
        {
            "danger" => "circle-alert",
            "info" => "info",
            _ => "check-circle-2"
        };
        <dialog class="dialog dialog--@(hasDiscrepancy ? "lg" : "md") dialog--@resultVariant" id="module-result-dialog" data-open-on-load="true" data-dialog-return-focus="add-module-button" closedby="closerequest" data-result="@success.Kind" aria-labelledby="module-result-heading" aria-describedby="module-result-description">
            <form class="dialog-layout" method="dialog">
                <div class="dialog-header">
                    <span class="dialog-icon" aria-hidden="true"><i data-lucide="@resultIcon"></i></span>
                    <div class="dialog-heading"><h2 class="dialog-title" id="module-result-heading">@success.Title</h2></div>
                    <button class="ui-icon-button" type="submit" aria-label="Close" title="Close"><i data-lucide="x" aria-hidden="true"></i></button>
                </div>
                <div class="dialog-body module-result-content">
                    <span class="module-result-code module-code" id="module-result-code">HTTP @success.StatusCode</span>
                    <p id="module-result-description">@success.Description</p>
                    @if (success.DiscrepancyReport is { HasDiscrepancy: true } discrepancy)
                    {
                        var extraRoutes = discrepancy.ExtraEndpoints ?? [];
                        var missingRoutes = discrepancy.MissingEndpoints ?? [];
                        var matchedRoutes = discrepancy.MatchedEndpoints ?? [];
                        <div class="module-discrepancy-summary" id="creation-discrepancy-report">
                            @if (extraRoutes.Count > 0)
                            {
                                <div class="module-discrepancy-group" data-discrepancy-group="extra">
                                    <div class="module-discrepancy-group-header">
                                        <span class="module-badge badge-pending"><span aria-hidden="true"></span>Extra endpoints (@extraRoutes.Count)</span>
                                        <span class="module-discrepancy-hint">Discovered by scanner, not specified</span>
                                    </div>
                                    <ul class="module-discrepancy-routes">
                                        @foreach (var ep in extraRoutes)
                                        {
                                            var m = ep.HttpMethod.ToUpperInvariant();
                                            <li><span class="endpoint-method">@m</span><span class="module-code">@ep.EndpointPath</span></li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (missingRoutes.Count > 0)
                            {
                                <div class="module-discrepancy-group" data-discrepancy-group="missing">
                                    <div class="module-discrepancy-group-header">
                                        <span class="module-badge badge-failed"><span aria-hidden="true"></span>Missing endpoints (@missingRoutes.Count)</span>
                                        <span class="module-discrepancy-hint">Specified by user, not found by scanner</span>
                                    </div>
                                    <ul class="module-discrepancy-routes">
                                        @foreach (var ep in missingRoutes)
                                        {
                                            var m = ep.HttpMethod.ToUpperInvariant();
                                            <li><span class="endpoint-method">@m</span><span class="module-code">@ep.EndpointPath</span></li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (matchedRoutes.Count > 0)
                            {
                                <div class="module-discrepancy-group" data-discrepancy-group="matched">
                                    <div class="module-discrepancy-group-header">
                                        <span class="module-badge badge-running"><span aria-hidden="true"></span>Matched endpoints (@matchedRoutes.Count)</span>
                                        <span class="module-discrepancy-hint">Specified and verified by scanner</span>
                                    </div>
                                    <ul class="module-discrepancy-routes">
                                        @foreach (var ep in matchedRoutes)
                                        {
                                            var m = ep.HttpMethod.ToUpperInvariant();
                                            <li><span class="endpoint-method">@m</span><span class="module-code">@ep.EndpointPath</span></li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="dialog-footer">
                    <button class="ui-button" type="submit" autofocus>Close</button>
                    @if (success.ModuleUrl is not null)
                    {
                        <a class="ui-button ui-button-primary" id="module-result-link" href="@success.ModuleUrl"><i data-lucide="arrow-up-right" aria-hidden="true"></i><span>Go to module</span></a>
                    }
                </div>
            </form>
        </dialog>
    }
    </div>
</div>

@section Scripts {
    <script src="~/js/modules.js" asp-append-version="true"></script>
}
