@model DetailModel
@{
    var module = Model.Module!;
    var deleteVersionId = Model.OrderedVersions.FirstOrDefault(version => version.Version == Model.DeleteVersionTarget)?.Id;
    var dialogHeader = new DialogHeaderModel("delete-version-heading", "Delete module version?", "trash-2");
}
<dialog class="dialog dialog--sm dialog--danger" id="delete-version-dialog" data-open-on-load="@(Model.ReopenDeleteVersion ? "true" : "false")" data-dialog-return-focus="@(deleteVersionId.HasValue ? $"delete-version-{deleteVersionId}" : null)" closedby="closerequest" aria-labelledby="@dialogHeader.HeadingId" aria-describedby="delete-version-description">
    <partial name="_DialogHeader" model="dialogHeader" />
    <form class="dialog-layout" id="delete-version-form" method="post" asp-page="/Modules/Detail" asp-page-handler="DeleteVersion" asp-route-id="@module.Id">
        <div class="dialog-body">
            @if (Model.DeleteVersionError is { } deleteVersionError)
            {
                <div class="module-form-error" role="alert">
                    <strong>@deleteVersionError.Title</strong> <span class="module-code">HTTP @deleteVersionError.StatusCode</span>
                    <p>@deleteVersionError.Description</p>
                </div>
            }
            <input type="hidden" name="moduleName" value="@module.ModuleName" />
            <input type="hidden" name="version" id="delete-version-target" value="@Model.DeleteVersionTarget" />
            <p class="dialog-description" id="delete-version-description">Permanently delete version <strong class="module-code" id="delete-version-label">@Model.DeleteVersionTarget</strong> of <strong>@module.ModuleName</strong>? This will remove the stored files for this version. This cannot be undone.</p>
        </div>
        <div class="dialog-footer">
            <partial name="_DialogCancelButton" />
            <button class="ui-button ui-button-danger" type="submit"><i data-lucide="trash-2" aria-hidden="true"></i><span>Delete version</span></button>
        </div>
    </form>
</dialog>
