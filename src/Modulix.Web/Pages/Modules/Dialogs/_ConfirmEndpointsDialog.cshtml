@model DetailModel
@using Modulix.Web.Models
@{
    var module = Model.Module!;
    var pendingEndpoints = Model.PendingEndpoints;
    var dialogHeader = new DialogHeaderModel("confirm-endpoints-heading", "Confirm pending endpoints", "check-circle-2", "Review differences before activation.");
}
<dialog class="dialog dialog--lg dialog--info" id="confirm-endpoints-dialog" data-open-on-load="@(Model.ReopenConfirmEndpoints ? "true" : "false")" closedby="closerequest" aria-labelledby="@dialogHeader.HeadingId" aria-describedby="confirm-endpoints-description">
    <partial name="_DialogHeader" model="dialogHeader" />
    <form class="dialog-layout" id="confirm-endpoints-form" method="post" asp-page="/Modules/Detail" asp-page-handler="ConfirmEndpoints" asp-route-id="@module.Id">
        <div class="dialog-body">
            @if (Model.ConfirmEndpointsError is { } confirmError)
            {
                <div class="module-form-error" role="alert">
                    <strong>@confirmError.Title</strong> <span class="module-code">HTTP @confirmError.StatusCode</span>
                    <p>@confirmError.Description</p>
                </div>
            }
            <input type="hidden" name="moduleName" value="@module.ModuleName" />
            <fieldset class="module-form-fields" id="module-confirm-endpoints-fields">
                <p class="dialog-description" id="confirm-endpoints-description">Review the pending discrepancy endpoints for <strong>@module.ModuleName</strong>. Extra endpoints discovered by the scanner default to <strong>Confirm (Activate)</strong>, while missing endpoints default to <strong>Remove endpoint</strong>. Once all pending endpoints are resolved, the module container will be built and started automatically.</p>
                @if (pendingEndpoints.Count == 0)
                {
                    <p class="module-section-empty">No pending endpoints require confirmation.</p>
                }
                else
                {
                    <div class="confirm-endpoints-list">
                        @for (var i = 0; i < pendingEndpoints.Count; i++)
                        {
                            var pendingEp = pendingEndpoints[i];
                            var methodUpper = pendingEp.HttpMethod.ToUpperInvariant();
                            var methodClass = methodUpper switch
                            {
                                "GET" => "method-get",
                                "POST" => "method-post",
                                "PUT" or "PATCH" => "method-put",
                                "DELETE" => "method-delete",
                                _ => "method-other"
                            };
                            var discrepancyKind = Model.GetEndpointDiscrepancyKind(
                                pendingEp.HttpMethod,
                                pendingEp.EndpointPath,
                                pendingEp.DiscoveredInVersion);
                            var discrepancyKindAttr = discrepancyKind switch
                            {
                                EndpointDiscrepancyKind.Extra => "extra",
                                EndpointDiscrepancyKind.Missing => "missing",
                                _ => "pending"
                            };
                            <div class="confirm-endpoint-item" data-discrepancy-kind="@discrepancyKindAttr">
                                <input type="hidden" name="decisions[@i].HttpMethod" value="@pendingEp.HttpMethod" />
                                <input type="hidden" name="decisions[@i].EndpointPath" value="@pendingEp.EndpointPath" />
                                <div class="confirm-endpoint-info">
                                    <div class="endpoint-route">
                                        <span class="endpoint-method @methodClass">@methodUpper</span>
                                        <span class="module-code">/@module.BaseUrlPath.Trim('/')@pendingEp.EndpointPath</span>
                                    </div>
                                    @if (discrepancyKind == EndpointDiscrepancyKind.Extra)
                                    {
                                        <div class="confirm-endpoint-reason">
                                            <span class="module-badge badge-pending"><span aria-hidden="true"></span>Extra endpoint</span>
                                            <span>Discovered by scanner, not specified by user</span>
                                        </div>
                                    }
                                    else if (discrepancyKind == EndpointDiscrepancyKind.Missing)
                                    {
                                        <div class="confirm-endpoint-reason">
                                            <span class="module-badge badge-failed"><span aria-hidden="true"></span>Missing endpoint</span>
                                            <span>Specified by user, not found by scanner</span>
                                        </div>
                                    }
                                </div>
                                <select name="decisions[@i].Action" aria-label="Action for @methodUpper @pendingEp.EndpointPath">
                                    <option value="activate" selected="@(discrepancyKind == EndpointDiscrepancyKind.Extra)">Confirm (Activate)</option>
                                    <option value="remove" selected="@(discrepancyKind != EndpointDiscrepancyKind.Extra)">Remove endpoint</option>
                                </select>
                            </div>
                        }
                    </div>
                }
            </fieldset>
        </div>
        <div class="dialog-footer">
            <partial name="_DialogCancelButton" />
            @if (pendingEndpoints.Count > 0)
            {
                <button class="ui-button ui-button-primary" type="submit"><i data-lucide="check" aria-hidden="true"></i><span>Confirm endpoints</span></button>
            }
        </div>
    </form>
</dialog>
