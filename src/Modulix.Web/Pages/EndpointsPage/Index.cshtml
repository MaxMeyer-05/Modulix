@page "/endpoints"
@using System.Globalization
@using Modulix.Client.Models.Enums
@model Modulix.Web.Pages.EndpointsPage.IndexModel
@{
    ViewData["Title"] = "API endpoints";
    var endpoints = Model.Endpoints;
    var methods = new (string Value, string Label)[]
    {
        ("", "All methods"),
        ("GET", "GET"),
        ("POST", "POST"),
        ("PUT", "PUT"),
        ("PATCH", "PATCH"),
        ("DELETE", "DELETE")
    };
    var statuses = new (string Value, string Label)[]
    {
        ("", "All statuses"),
        (nameof(ModuleEndpointsStatus.Active), "Active"),
        (nameof(ModuleEndpointsStatus.PendingConfirmation), "Pending confirmation"),
        (nameof(ModuleEndpointsStatus.Inactive), "Inactive")
    };
    var resetUrl = Url.Page("/EndpointsPage/Index");
    var autoRefresh = new PageAutoRefreshModel(Model.GetPageUrl(Model.CurrentPage));
}
<div class="page modules-page" data-auto-refresh="300">
    <header class="page-header">
        <div class="page-header-main">
            <h1 class="page-title">API endpoints</h1>
            <p class="page-description">Inspect endpoints registered by your modules.</p>
        </div>
    </header>

    <form class="page-toolbar" method="get" action="@resetUrl">
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <div class="module-search-field">
            <i data-lucide="search" aria-hidden="true"></i>
            <input id="endpoint-search" name="q" type="search" value="@Model.Query" placeholder="Search by path, module, method or ID..." aria-label="Search endpoints" autocomplete="off" />
        </div>
        <label class="module-select-label"><span>Status</span>
            <select id="endpoint-status-filter" name="status">
                @foreach (var (value, label) in statuses)
                {
                    <option value="@value" selected="@(Model.StatusFilter.Equals(value, StringComparison.OrdinalIgnoreCase))">@label</option>
                }
            </select>
        </label>
        <label class="module-select-label"><span>Method</span>
            <select id="endpoint-method-filter" name="method">
                @foreach (var (value, label) in methods)
                {
                    <option value="@value" selected="@(Model.MethodFilter == value)">@label</option>
                }
            </select>
        </label>
        <button class="module-button" type="submit"><i data-lucide="search" aria-hidden="true"></i><span>Apply</span></button>
        <partial name="_AutoRefresh" model="autoRefresh" />
    </form>

    <div class="page-content">
    @if (!ViewData.ModelState.IsValid)
    {
        <partial name="_ErrorState" model='new PageErrorStateModel("Endpoints request failed") { ValidationSummary = ValidationSummary.All }' />
    }

    @if (ViewData.ModelState.IsValid)
    {
    <p class="module-result-count" id="endpoint-result-count" role="status">
        @(endpoints.Count == Model.TotalEndpoints ? $"{endpoints.Count} endpoints" : $"{endpoints.Count} of {Model.TotalEndpoints} endpoints (page {Model.CurrentPage} of {Model.TotalPages})")
    </p>
    }

    @if (endpoints.Count > 0)
    {
        <div class="data-table-container" role="region" aria-label="Registered API endpoints" tabindex="0">
            <table class="data-table" id="endpoints-table">
                <thead>
                    <tr>
                        <th scope="col">Method</th>
                        <th scope="col">Endpoint path</th>
                        <th scope="col">Module</th>
                        <th scope="col">Status</th>
                        <th scope="col">Created</th>
                        <th scope="col">Endpoint ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var endpoint in endpoints)
                    {
                        var methodUpper = endpoint.HttpMethod.ToUpperInvariant();
                        var methodClass = methodUpper switch
                        {
                            "GET" => "method-get",
                            "POST" => "method-post",
                            "PUT" or "PATCH" => "method-put",
                            "DELETE" => "method-delete",
                            _ => "method-other"
                        };
                        var statusBadgeClass = endpoint.Status switch
                        {
                            ModuleEndpointsStatus.Active => "badge-running",
                            ModuleEndpointsStatus.PendingConfirmation => "badge-pending",
                            _ => ""
                        };
                        var statusLabel = endpoint.Status == ModuleEndpointsStatus.PendingConfirmation
                            ? "Pending confirmation"
                            : endpoint.Status.ToString();
                        <tr>
                            <td>
                                <span class="endpoint-method @methodClass">@methodUpper</span>
                            </td>
                            <td>
                                <span class="module-code">@endpoint.EndpointPath</span>
                            </td>
                            <td>
                                <span class="endpoint-module-tag">
                                    <i data-lucide="box" aria-hidden="true"></i>
                                    <span>@endpoint.ModuleName</span>
                                </span>
                            </td>
                            <td>
                                <span class="module-badge @statusBadgeClass">
                                    <span aria-hidden="true"></span>@statusLabel
                                </span>
                            </td>
                            <td class="data-table-muted">
                                @endpoint.CreatedAtUtc.ToString("MMM d, yyyy HH:mm 'UTC'", CultureInfo.InvariantCulture)
                            </td>
                            <td>
                                <div class="module-copy-value">
                                    <span class="module-code">@endpoint.Id</span>
                                    <button class="module-icon-button" type="button" data-copy="@endpoint.Id" aria-label="Copy endpoint ID" title="Copy endpoint ID">
                                        <i data-lucide="copy" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (ViewData.ModelState.IsValid)
    {
        @if (Model.TotalEndpoints == 0)
        {
            <partial name="_EmptyState" model='new PageEmptyStateModel("No API endpoints registered", "link") {
                Id = "endpoints-empty-state",
                Description = "Upload and scan a module to discover and register its HTTP endpoints."
            }' />
        }
        else
        {
            <partial name="_EmptyState" model='new PageEmptyStateModel("No endpoints found", "link") {
                Id = "endpoints-empty-state",
                Description = "No endpoints match your search and filter criteria.",
                ActionText = "Reset filters",
                ActionUrl = resetUrl,
                ActionIcon = "rotate-ccw"
            }' />
        }
    }
    @if (Model.TotalEndpoints > 0)
    {
        var startPage = Math.Max(1, Model.CurrentPage - 2);
        var endPage = Math.Min(Model.TotalPages, startPage + 4);
        startPage = Math.Max(1, endPage - 4);
        <footer class="module-pagination-bar" aria-label="Endpoints pagination">
            <form class="module-pagination-size" method="get" action="@resetUrl">
                @if (!string.IsNullOrWhiteSpace(Model.Query))
                {
                    <input type="hidden" name="q" value="@Model.Query" />
                }
                @if (!string.IsNullOrWhiteSpace(Model.MethodFilter))
                {
                    <input type="hidden" name="method" value="@Model.MethodFilter" />
                }
                @if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
                {
                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                }
                <input type="hidden" name="page" value="1" />
                <label class="module-pagination-size-label" for="endpoints-page-size">
                    <span>Rows per page</span>
                    <select id="endpoints-page-size" name="pageSize" data-page-size-select>
                        @foreach (var size in Modulix.Web.Pages.EndpointsPage.IndexModel.AllowedPageSizes)
                        {
                            <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                        }
                    </select>
                </label>
                <span class="module-pagination-summary">Page @Model.CurrentPage of @Model.TotalPages (@Model.TotalEndpoints total)</span>
            </form>
            <nav class="module-pagination-controls" aria-label="Endpoints page navigation">
                @if (Model.HasPreviousPage)
                {
                    <a class="module-button module-button-compact" href="@Model.GetPageUrl(Model.CurrentPage - 1)" aria-label="Previous page">
                        <i data-lucide="chevron-left" aria-hidden="true"></i><span>Previous</span>
                    </a>
                }
                @for (var p = startPage; p <= endPage; p++)
                {
                    if (p == Model.CurrentPage)
                    {
                        <span class="module-button module-button-compact module-button-primary" aria-current="page">@p</span>
                    }
                    else
                    {
                        <a class="module-button module-button-compact" href="@Model.GetPageUrl(p)" aria-label="Page @p">@p</a>
                    }
                }
                @if (Model.HasNextPage)
                {
                    <a class="module-button module-button-compact" href="@Model.GetPageUrl(Model.CurrentPage + 1)" aria-label="Next page">
                        <span>Next</span><i data-lucide="chevron-right" aria-hidden="true"></i>
                    </a>
                }
            </nav>
        </footer>
    }
    <span class="visually-hidden" id="module-copy-feedback" role="status"></span>
    </div>
</div>

@section Scripts {
    <script src="~/js/modules.js" asp-append-version="true"></script>
}
