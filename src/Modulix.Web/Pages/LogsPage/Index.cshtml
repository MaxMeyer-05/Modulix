@page "/logs"
@{
    ViewData["Title"] = "Logs";
}
@section Styles {
    <link rel="stylesheet" href="~/css/logs.css" asp-append-version="true" />
}

<div class="logs-page">
    <header class="logs-header">
        <h1>Logs</h1>
        <span class="logs-preview"><span aria-hidden="true"></span>Sample data</span>
    </header>

    <div class="logs-workspace">
        <aside class="log-archive" aria-labelledby="log-files-heading">
            <header class="log-archive-heading">
                <h2 id="log-files-heading"><i data-lucide="folder-open" aria-hidden="true"></i>Log files</h2>
                <span id="log-file-count"></span>
            </header>
            <div class="log-archive-filters">
                <label class="log-field" for="log-service">Application
                    <select id="log-service">
                        <option value="">All applications</option>
                        <option value="Modulix">Modulix</option>
                        <option value="Modulix.Web">Modulix.Web</option>
                    </select>
                </label>
                <label class="log-field" for="log-date">Date</label>
                <div class="log-date-field">
                    <input id="log-date" type="date" aria-label="Log file date" />
                    <button id="log-clear-date" class="log-icon-button" type="button" title="Clear date filter" aria-label="Clear date filter" disabled><i data-lucide="x" aria-hidden="true"></i></button>
                </div>
            </div>
            <nav class="log-file-list" id="log-file-list" aria-label="Log files" tabindex="0"></nav>
            <div class="log-archive-empty" id="log-archive-empty" hidden>
                <i data-lucide="folder-search" aria-hidden="true"></i>
                <p>No files for this selection.</p>
                <button class="log-text-button" id="log-reset-archive" type="button">Reset filters</button>
            </div>
            <footer class="log-archive-footer"><i data-lucide="archive" aria-hidden="true"></i><span id="log-archive-range"></span></footer>
        </aside>

        <section class="log-viewer" aria-labelledby="log-selected-name">
            <header class="log-viewer-heading">
                <div class="log-selected-file">
                    <span class="log-file-symbol"><i data-lucide="file-text" aria-hidden="true"></i></span>
                    <div><h2 id="log-selected-name">Select a log file</h2><p id="log-selected-meta">No file selected</p></div>
                </div>
                <button id="log-download" class="log-icon-button" type="button" title="Download selected file" aria-label="Download selected file" disabled><i data-lucide="download" aria-hidden="true"></i></button>
            </header>

            <div class="log-toolbar">
                <div class="log-search">
                    <i data-lucide="search" aria-hidden="true"></i>
                    <input id="log-search" type="search" placeholder="Search entries..." aria-label="Search log entries" autocomplete="off" />
                </div>
                <select id="log-level" aria-label="Log level">
                    <option value="">All levels</option>
                    <option value="ERROR">Error</option>
                    <option value="WARN">Warning</option>
                    <option value="INFO">Information</option>
                    <option value="DEBUG">Debug</option>
                </select>
                <label class="log-wrap"><input id="log-wrap" type="checkbox" checked />Wrap lines</label>
            </div>

            <div class="log-summary" aria-label="File summary">
                <span><strong id="log-total">0</strong> entries</span>
                <span class="log-summary-error"><span aria-hidden="true"></span><strong id="log-errors">0</strong><span id="log-error-label">errors</span></span>
                <span class="log-summary-warning"><span aria-hidden="true"></span><strong id="log-warnings">0</strong><span id="log-warning-label">warnings</span></span>
                <span class="log-order"><i data-lucide="arrow-down" aria-hidden="true"></i>Oldest first</span>
            </div>

            <div class="log-content" id="log-content" tabindex="0" role="region" aria-label="Log entries">
                <table class="log-table" id="log-table">
                    <caption class="visually-hidden">Entries in the selected log file</caption>
                    <thead><tr><th scope="col" class="log-time">Time</th><th scope="col" class="log-level-cell">Level</th><th scope="col" class="log-source">Source</th><th scope="col">Message</th></tr></thead>
                    <tbody id="log-entries"></tbody>
                </table>
                <div class="log-empty" id="log-empty" hidden>
                    <i data-lucide="search-x" aria-hidden="true"></i>
                    <h3 id="log-empty-title">No matching entries</h3>
                    <button class="log-text-button" id="log-reset-entries" type="button">Clear search and level filter</button>
                </div>
            </div>
            <footer class="log-viewer-footer">
                <span id="log-result-count" role="status" aria-live="polite">0 entries</span>
                <button class="log-text-button" id="log-bottom" type="button"><i data-lucide="arrow-down-to-line" aria-hidden="true"></i>Go to bottom</button>
            </footer>
        </section>
    </div>
</div>
@section Scripts {
    <script src="~/js/logs.js" asp-append-version="true"></script>
}