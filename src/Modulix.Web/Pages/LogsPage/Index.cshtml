@page "/logs"
@model IndexModel
@{
    ViewData["Title"] = "Logs";
    var selected = Model.SelectedFile;
    var selectedName = selected?.Name;
    var dateValue = Model.Date?.ToString("yyyy-MM-dd");
    var clearDateValues = Model.PageValues(selectedName);
    clearDateValues.Remove("date");
    var levels = new (string Value, string Label)[]
    {
        ("", "All levels"), ("ERROR", "Error"), ("WARN", "Warning"),
        ("INFO", "Information"), ("DEBUG", "Debug"), ("TRACE", "Verbose"), ("FATAL", "Fatal")
    };
    string? lastDate = null;
}
@section Styles {
    <link rel="stylesheet" href="~/css/logs.css" asp-append-version="true" />
}

<div class="page logs-page">
    <header class="page-header">
        <div class="page-header-main">
            <h1 class="page-title">Logs</h1>
            <p class="page-description">Browse and filter application logs.</p>
        </div>
        <div class="page-header-actions">
            <span class="logs-preview"><span aria-hidden="true"></span>Modulix.Web</span>
        </div>
    </header>

    <form class="page-toolbar log-toolbar" id="log-filters" method="get" action="@Url.Page("/LogsPage/Index")">
        @if (selectedName is not null)
        {
            <input type="hidden" name="file" value="@selectedName" />
        }
        <div class="log-search">
            <i data-lucide="search" aria-hidden="true"></i>
            <input id="log-search" name="q" type="search" value="@Model.Query" placeholder="Search entries..." aria-label="Search log entries" autocomplete="off" />
        </div>
        <select id="log-level" name="level" aria-label="Log level">
            @foreach (var (value, label) in levels)
            {
                <option value="@value" selected="@(Model.Level == value)">@label</option>
            }
        </select>
        <label class="log-wrap"><input id="log-wrap" name="wrap" type="checkbox" value="true" checked="@Model.Wrap" />Wrap lines</label>
        <input type="hidden" name="wrap" value="false" />
        <button class="ui-button" type="submit">Apply</button>
    </form>

    <div class="page-content">
    @if (!ViewData.ModelState.IsValid)
    {
        <partial name="_ErrorState" model='new PageErrorStateModel("Invalid log filters") { ValidationSummary = ValidationSummary.All }' />
    }

    <div class="logs-workspace">
        <aside class="log-archive" aria-labelledby="log-files-heading">
            <header class="log-archive-heading">
                <h2 id="log-files-heading"><i data-lucide="folder-open" aria-hidden="true"></i>Log files</h2>
                <span id="log-file-count">@(Model.ArchiveError is null ? $"{Model.Matches.Count} files" : "Unavailable")</span>
            </header>
            <div class="log-archive-filters">
                <label class="log-field" for="log-service">Application
                    <select id="log-service" name="service" form="log-filters">
                        <option value="">All applications</option>
                        <option value="@IndexModel.ServiceName" selected="@(Model.Service == IndexModel.ServiceName)">@IndexModel.ServiceName</option>
                    </select>
                </label>
                <label class="log-field" for="log-date">Date</label>
                <div class="log-date-field">
                    <input id="log-date" name="date" form="log-filters" type="date" value="@dateValue" max="@IndexModel.Today.ToString("yyyy-MM-dd")" aria-label="Log file date" />
                    @if (Model.Date is not null)
                    {
                        <a class="log-icon-button" href="@Url.Page("/LogsPage/Index", clearDateValues)" title="Clear date filter" aria-label="Clear date filter"><i data-lucide="x" aria-hidden="true"></i></a>
                    }
                </div>
                <button class="ui-button log-apply-button" type="submit" form="log-filters">Apply filters</button>
            </div>
            @if (Model.Matches.Count > 0)
            {
                <nav class="log-file-list" id="log-file-list" aria-label="Log files" tabindex="0">
                    @foreach (var file in Model.Matches)
                    {
                        var key = file.Date.ToString("yyyy-MM-dd");
                        if (key != lastDate)
                        {
                            <h3 class="log-file-group">@(file.Date == IndexModel.Today ? "Today / " : "")@IndexModel.FormatDate(file.Date)</h3>
                            lastDate = key;
                        }
                        <a class="log-file-button" href="@Url.Page("/LogsPage/Index", Model.PageValues(file.Name, includeEntryFilter: false))" aria-current="@(file.Name == selectedName ? "true" : "false")">
                            <strong>@file.Name</strong>
                            <span class="log-file-facts">
                                <span>@IndexModel.FormatSize(file.Size)@(file.Name == selectedName && Model.IsLoaded ? $" / {Model.TotalEntries} entries" : "")</span>
                                @if (file.Name == selectedName && Model.IsLoaded)
                                {
                                    <span class="@(Model.Errors > 0 ? "log-file-errors" : "")">@(Model.Errors > 0 ? $"{Model.Errors} {IndexModel.Plural(Model.Errors, "error")}" : "No errors")</span>
                                }
                            </span>
                        </a>
                    }
                </nav>
            }
            else
            {
                @if (Model.ArchiveError is { } archiveError)
                {
                    <partial name="_ErrorState" model='new PageErrorStateModel("Log files unavailable") {
                        Id = "log-archive-empty",
                        DescriptionId = "log-archive-message",
                        Description = archiveError,
                        ActionText = "Retry",
                        ActionUrl = Url.Page("/LogsPage/Index", Model.PageValues(null))
                    }' />
                }
                else
                {
                    <partial name="_EmptyState" model='new PageEmptyStateModel("No files for this selection.", "folder-search") {
                        Id = "log-archive-empty",
                        TitleId = "log-archive-message",
                        InSection = true,
                        ActionText = "Reset filters",
                        ActionUrl = Url.Page("/LogsPage/Index", Model.PageValues(null, includeArchiveFilter: false)),
                        ActionIcon = "rotate-ccw"
                    }' />
                }
            }
            <footer class="log-archive-footer"><i data-lucide="archive" aria-hidden="true"></i><span id="log-archive-range">@(Model.ArchiveError is not null ? "Log files unavailable" : Model.Files.Count > 0 ? $"{IndexModel.FormatDate(Model.Files[^1].Date)} - {IndexModel.FormatDate(Model.Files[0].Date)}" : "No log files")</span></footer>
        </aside>

        <section class="log-viewer" aria-labelledby="log-selected-name">
            <header class="log-viewer-heading">
                <div class="log-selected-file">
                    <span class="log-file-symbol"><i data-lucide="file-text" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="log-selected-name">@(selectedName ?? "Select a log file")</h2>
                        <p id="log-selected-meta">@(selected is null ? "No file selected" : $"{IndexModel.ServiceName} / {IndexModel.FormatDate(selected.Date)} / {IndexModel.FormatSize(selected.Size)}")</p>
                    </div>
                </div>
                <div class="log-file-actions">
                    @if (Model.IsLoaded)
                    {
                        <a class="log-icon-button" href="@Url.Page("/LogsPage/Index", "Download", new { name = selectedName })" download="@selectedName" title="Download selected file" aria-label="Download selected file"><i data-lucide="download" aria-hidden="true"></i></a>
                    }
                    @if (selected is not null)
                    {
                        <button class="log-icon-button log-delete-button" type="button" title="Delete selected file" aria-label="Delete selected file" data-dialog-open="log-delete-dialog"><i data-lucide="trash-2" aria-hidden="true"></i></button>
                    }
                </div>
            </header>

            <div class="log-summary" aria-label="File summary">
                @if (Model.ReadError is not null || Model.ArchiveError is not null)
                {
                    <span>Log summary unavailable</span>
                }
                else
                {
                    <span><strong id="log-total">@Model.TotalEntries</strong> entries</span>
                    <span class="log-summary-error"><span aria-hidden="true"></span><strong id="log-errors">@Model.Errors</strong><span id="log-error-label">@IndexModel.Plural(Model.Errors, "error")</span></span>
                    <span class="log-summary-warning"><span aria-hidden="true"></span><strong id="log-warnings">@Model.Warnings</strong><span id="log-warning-label">@IndexModel.Plural(Model.Warnings, "warning")</span></span>
                    <span class="log-order"><i data-lucide="arrow-down" aria-hidden="true"></i>Oldest first</span>
                }
            </div>

            <div class="log-content" id="log-content" tabindex="0" role="region" aria-label="Log entries">
                @if (Model.Entries.Count > 0)
                {
                    <table class="log-table" id="log-table">
                        <caption class="visually-hidden">Entries in the selected log file</caption>
                        <thead><tr><th scope="col" class="log-time">Time</th><th scope="col" class="log-level-cell">Level</th><th scope="col" class="log-source">Source</th><th scope="col">Message</th></tr></thead>
                        <tbody id="log-entries">
                            @foreach (var entry in Model.Entries)
                            {
                                <tr>
                                    <td class="log-time">@entry.Time</td>
                                    <td class="log-level-cell"><span class="log-badge log-badge-@IndexModel.BadgeClass(entry.Level)">@entry.Level</span></td>
                                    <td class="log-source">@entry.Source</td>
                                    <td class="log-message">@entry.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <span id="log-end"></span>
                }
                else
                {
                    @if (Model.ReadError is { } readError)
                    {
                        <partial name="_ErrorState" model='new PageErrorStateModel("Log file unavailable") {
                            Id = "log-empty",
                            TitleId = "log-empty-title",
                            Description = readError,
                            ActionText = "Retry",
                            ActionUrl = Url.Page("/LogsPage/Index", Model.PageValues(selectedName))
                        }' />
                    }
                    else if (Model.ArchiveError is not null)
                    {
                        <partial name="_ErrorState" model='new PageErrorStateModel("Log file unavailable") {
                            Id = "log-empty",
                            TitleId = "log-empty-title",
                            Description = "The log archive could not be loaded.",
                            ActionText = "Retry",
                            ActionUrl = Url.Page("/LogsPage/Index", Model.PageValues(null))
                        }' />
                    }
                    else
                    {
                        var title = selected is null ? "No log file selected" : Model.TotalEntries > 0 ? "No matching entries" : "This log file is empty";
                        var canClearFilter = selected is not null && Model.HasEntryFilter;
                        <partial name="_EmptyState" model='new PageEmptyStateModel(title, "search-x") {
                            Id = "log-empty",
                            TitleId = "log-empty-title",
                            InSection = true,
                            ActionText = canClearFilter ? "Clear search and level filter" : null,
                            ActionUrl = canClearFilter ? Url.Page("/LogsPage/Index", Model.PageValues(selectedName, includeEntryFilter: false)) : null
                        }' />
                    }
                }
            </div>
            <footer class="log-viewer-footer">
                <span id="log-result-count" role="status" aria-live="polite">@(Model.ReadError is not null || Model.ArchiveError is not null ? "Log entries unavailable" : $"{Model.Entries.Count} of {Model.TotalEntries} entries")</span>
                @if (Model.Entries.Count > 0)
                {
                    <a class="log-text-button" href="#log-end"><i data-lucide="arrow-down-to-line" aria-hidden="true"></i>Go to bottom</a>
                }
            </footer>
        </section>
    </div>

    @if (Model.FeedbackError is not null)
    {
        <partial name="_ErrorState" model='new PageErrorStateModel("Log operation failed") { Description = Model.FeedbackError }' />
    }

    @if (selected is not null)
    {
        <dialog id="log-delete-dialog" class="dialog dialog--sm dialog--danger" closedby="closerequest" aria-labelledby="log-delete-heading" aria-describedby="log-delete-description">
            <form class="dialog-layout" method="post" asp-page-handler="Delete" id="log-delete-form">
                <div class="dialog-header">
                    <span class="dialog-icon" aria-hidden="true"><i data-lucide="trash-2"></i></span>
                    <div class="dialog-heading"><h2 class="dialog-title" id="log-delete-heading">Delete log file?</h2></div>
                    <button class="ui-icon-button" type="button" data-dialog-close aria-label="Close" title="Close"><i data-lucide="x" aria-hidden="true"></i></button>
                </div>
                <div class="dialog-body">
                    <p class="dialog-description" id="log-delete-description">Permanently delete <strong id="log-delete-name">@selectedName</strong>? This cannot be undone.</p>
                    <input type="hidden" name="name" value="@selectedName" />
                    @if (!string.IsNullOrEmpty(Model.Service))
                    {
                        <input type="hidden" name="service" value="@Model.Service" />
                    }
                    @if (dateValue is not null)
                    {
                        <input type="hidden" name="date" value="@dateValue" />
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Query))
                    {
                        <input type="hidden" name="q" value="@Model.Query" />
                    }
                    @if (!string.IsNullOrEmpty(Model.Level))
                    {
                        <input type="hidden" name="level" value="@Model.Level" />
                    }
                    <input type="hidden" name="wrap" value="@(Model.Wrap ? "true" : "false")" />
                </div>
                <div class="dialog-footer">
                    <button id="log-delete-cancel" class="ui-button" type="button" data-dialog-close autofocus>Cancel</button>
                    <button id="log-delete-confirm" class="ui-button ui-button-danger" type="submit"><i data-lucide="trash-2" aria-hidden="true"></i><span>Delete file</span></button>
                </div>
            </form>
        </dialog>
    }
    </div>
</div>
