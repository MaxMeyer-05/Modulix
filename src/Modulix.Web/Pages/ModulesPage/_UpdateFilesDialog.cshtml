@model DetailModel
@{
    var module = Model.Module!;
    var dialogHeader = new DialogHeaderModel("update-files-heading", "Update module files", "upload");
}
<dialog class="dialog dialog--md" id="update-files-dialog" data-open-on-load="@(Model.ReopenUpdateFiles ? "true" : "false")" closedby="closerequest" aria-labelledby="@dialogHeader.HeadingId">
    <partial name="_DialogHeader" model="dialogHeader" />
    <form class="dialog-layout" id="update-files-form" method="post" asp-page="/ModulesPage/Detail" asp-page-handler="UpdateFiles" asp-route-id="@module.Id" enctype="multipart/form-data">
        <div class="dialog-body">
            @if (Model.UpdateFilesError is { } filesError)
            {
                <div class="module-form-error" role="alert">
                    <strong>@filesError.Title</strong> <span class="module-code">HTTP @filesError.StatusCode</span>
                    <p>@filesError.Description</p>
                </div>
            }
            <fieldset class="module-form-fields" id="module-update-files-fields">
                <p class="dialog-description">Upload a new ZIP archive to deploy a new version of <strong>@module.ModuleName</strong> (current version: <span class="module-code">@module.CurrentVersion</span>). The archive will be scanned with high priority before replacing the active container.</p>
                <label>
                    <span>Version <span class="required-mark">*</span></span>
                    <input name="Version" value="@Model.UpdateFilesInput?.Version" required maxlength="50" placeholder="v1.1.0" />
                </label>
                <label>
                    <span>Changelog</span>
                    <textarea name="Changelog" rows="2" maxlength="500" placeholder="Optional changelog for this version">@Model.UpdateFilesInput?.Changelog</textarea>
                </label>
                <span class="module-field-label">Module archive <span class="required-mark">*</span></span>
                <label class="module-upload" id="module-update-upload-area" for="module-update-archive">
                    <i data-lucide="upload" aria-hidden="true"></i>
                    <strong>Choose a ZIP archive</strong>
                    <input id="module-update-archive" name="ModuleFile" type="file" accept=".zip,application/zip" aria-label="Module archive" required />
                </label>
            </fieldset>
        </div>
        <div class="dialog-footer">
            <partial name="_DialogCancelButton" />
            <button class="ui-button ui-button-primary" type="submit"><i data-lucide="upload" aria-hidden="true"></i><span>Update files</span></button>
        </div>
    </form>
</dialog>
