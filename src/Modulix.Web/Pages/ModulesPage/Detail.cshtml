@page "/modules/{id:guid}"
@model DetailModel
@using System.Globalization
@{
    var module = Model.Module;
    ViewData["Title"] = module?.ModuleName ?? "Module not found";
    var reopenEdit = Model.EditError is not null;
    var reopenUpdateFiles = Model.UpdateFilesError is not null;
    var reopenRollback = Model.RollbackError is not null;
    var reopenConfirmEndpoints = Model.ConfirmEndpointsError is not null;
    var reopenDelete = Model.DeleteError is not null;
    var detailUrl = module is not null ? Url.Page("/ModulesPage/Detail", new { id = module.Id }) : Url.Page("/ModulesPage/Index");
    var canStart = module?.Status is Modulix.Client.Models.Enums.ModuleStatus.Stopped
        or Modulix.Client.Models.Enums.ModuleStatus.Created
        or Modulix.Client.Models.Enums.ModuleStatus.Failed;
    var canStop = module?.Status is Modulix.Client.Models.Enums.ModuleStatus.Running
        or Modulix.Client.Models.Enums.ModuleStatus.Starting;
    var orderedVersions = module?.Versions
        .OrderByDescending(v => v.ReleasedAtUtc)
        .ThenByDescending(v => v.Id)
        .ToList() ?? [];
    var currentVersion = orderedVersions.FirstOrDefault(v =>
        string.Equals(v.Version, module?.CurrentVersion, StringComparison.Ordinal));
    var rollbackVersions = orderedVersions
        .Where(v => !string.Equals(v.Version, module?.CurrentVersion, StringComparison.Ordinal))
        .ToList();
    var pendingEndpoints = module?.Endpoints
        .Where(e => e.Status == Modulix.Client.Models.Enums.ModuleEndpointsStatus.PendingConfirmation)
        .ToList() ?? [];
    var hasPendingEndpoints = module?.Status == Modulix.Client.Models.Enums.ModuleStatus.PendingConfirmation
        || pendingEndpoints.Count > 0;
    var canConfirmEndpoints = module?.Status == Modulix.Client.Models.Enums.ModuleStatus.PendingConfirmation
        && pendingEndpoints.Count > 0;
    var canRollback = module is not null
        && rollbackVersions.Count > 0
        && module.Status != Modulix.Client.Models.Enums.ModuleStatus.QueuedForScan
        && !hasPendingEndpoints;
    var rollbackTitle = module is null
        ? "Module not available"
        : module.Status == Modulix.Client.Models.Enums.ModuleStatus.QueuedForScan
            ? "Cannot roll back module while queued for scanning"
            : hasPendingEndpoints
                ? "Confirm pending endpoints before rolling back"
                : rollbackVersions.Count == 0
                    ? "No previous versions available to roll back to"
                    : "Roll back this module to an earlier version";
}
@section Styles {
    <link rel="stylesheet" href="~/css/modules.css" asp-append-version="true" />
}
<div class="modules-page">
    <a class="module-back-link" asp-page="/ModulesPage/Index"><i data-lucide="arrow-left" aria-hidden="true"></i><span>All modules</span></a>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="modules-error" role="alert">
            <i data-lucide="circle-alert" aria-hidden="true"></i>
            <div>
                <strong>Module request failed</strong>
                <div asp-validation-summary="All"></div>
            </div>
        </div>
    }

    @if (Model.Feedback is { } feedback)
    {
        <div class="queue-feedback @(feedback.IsSuccess ? "queue-feedback-success" : "modules-error")" role="status">
            <i data-lucide="@(feedback.IsSuccess ? "check-circle-2" : "circle-alert")" aria-hidden="true"></i>
            <div>
                <strong>@feedback.Title</strong>
                <p>@feedback.Description</p>
            </div>
        </div>
    }

    @if (module is null)
    {
        <div class="module-empty-state">
            <i data-lucide="box" aria-hidden="true"></i><h1>Module not found</h1>
        </div>
    }
    else
    {
        <header class="module-detail-header">
            <div class="module-detail-title">
                <span class="module-symbol module-symbol-large"><i data-lucide="box" aria-hidden="true"></i></span>
                <div><div class="modules-title"><h1>@module.ModuleName</h1></div><p>@module.Description</p></div>
            </div>
            <span class="module-badge badge-@ModuleStatusDisplay.StatusClass(module.Status)"><span aria-hidden="true"></span>@ModuleStatusDisplay.StatusLabel(module.Status)</span>
        </header>
        <div class="module-detail-layout">
            <div class="module-detail-main">
                <section class="module-info-section" aria-labelledby="module-info-heading">
                    <h2 id="module-info-heading">Module information</h2>
                    <dl class="module-detail-facts">
                        <div class="module-fact-wide"><dt>Module ID</dt><dd class="module-copy-value"><span class="module-code">@module.Id</span><button class="module-icon-button" type="button" data-copy="@module.Id" aria-label="Copy module ID" title="Copy module ID"><i data-lucide="copy" aria-hidden="true"></i></button></dd></div>
                        <div><dt>Base path</dt><dd class="module-code">@module.BaseUrlPath</dd></div>
                        <div><dt>Container port</dt><dd>@module.ContainerPort</dd></div>
                        <div><dt>Current version</dt><dd class="module-code">@module.CurrentVersion</dd></div>
                        <div><dt>Created</dt><dd>@module.CreatedAtUtc.ToString("MMM d, yyyy 'at' HH:mm 'UTC'", CultureInfo.InvariantCulture)</dd></div>
                    </dl>
                </section>
                <section class="module-info-section" aria-labelledby="module-endpoints-heading">
                    <div class="module-section-heading">
                        <h2 id="module-endpoints-heading">Registered endpoints</h2>
                        <div class="module-section-heading-actions">
                            <span>@module.Endpoints.Count() endpoints</span>
                            @if (canConfirmEndpoints)
                            {
                                <button class="module-button module-button-compact module-button-primary" type="button" popovertarget="confirm-endpoints-dialog">
                                    <i data-lucide="check-circle-2" aria-hidden="true"></i><span>Confirm pending (@pendingEndpoints.Count)</span>
                                </button>
                            }
                        </div>
                    </div>
                    @if (!module.Endpoints.Any())
                    {
                        <p class="module-section-empty">No endpoints registered.</p>
                    }
                    else
                    {
                        <ul class="module-endpoint-list">
                            @foreach (var endpoint in module.Endpoints)
                            {
                                var methodUpper = endpoint.HttpMethod.ToUpperInvariant();
                                var methodClass = methodUpper switch
                                {
                                    "GET" => "method-get",
                                    "POST" => "method-post",
                                    "PUT" or "PATCH" => "method-put",
                                    "DELETE" => "method-delete",
                                    _ => "method-other"
                                };
                                var isPendingEndpoint = endpoint.Status == Modulix.Client.Models.Enums.ModuleEndpointsStatus.PendingConfirmation;
                                <li>
                                    <div class="endpoint-route"><span class="endpoint-method @methodClass">@methodUpper</span><span class="module-code">/@module.BaseUrlPath.Trim('/')@endpoint.EndpointPath</span></div>
                                    <div class="endpoint-status-actions">
                                        <span class="endpoint-state @(isPendingEndpoint ? "endpoint-state-pending" : "")">@(isPendingEndpoint ? "Pending confirmation" : endpoint.Status.ToString())</span>
                                        @if (isPendingEndpoint && module.Status == Modulix.Client.Models.Enums.ModuleStatus.PendingConfirmation)
                                        {
                                            <form class="inline-action-form" method="post" asp-page="/ModulesPage/Detail" asp-page-handler="ConfirmEndpoints" asp-route-id="@module.Id">
                                                <input type="hidden" name="moduleName" value="@module.ModuleName" />
                                                <input type="hidden" name="decisions[0].HttpMethod" value="@endpoint.HttpMethod" />
                                                <input type="hidden" name="decisions[0].EndpointPath" value="@endpoint.EndpointPath" />
                                                <button class="module-button module-button-compact module-button-primary" type="submit" name="decisions[0].Action" value="activate" title="Confirm and activate this endpoint">
                                                    <i data-lucide="check" aria-hidden="true"></i><span>Confirm</span>
                                                </button>
                                                <button class="module-button module-button-compact module-button-danger" type="submit" name="decisions[0].Action" value="remove" title="Remove this pending endpoint">
                                                    <i data-lucide="trash-2" aria-hidden="true"></i><span>Remove</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                    <div class="endpoint-metadata">
                                        @if (!string.IsNullOrWhiteSpace(endpoint.DiscoveredInVersion))
                                        {
                                            <span>Version <span class="module-code">@endpoint.DiscoveredInVersion</span></span>
                                        }
                                        <span>Created @endpoint.CreatedAtUtc.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</span>
                                        <span class="module-code">@endpoint.Id</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>
            <aside class="module-detail-aside">
                <section class="module-info-section" aria-labelledby="module-runtime-heading">
                    <h2 id="module-runtime-heading">Runtime &amp; storage</h2>
                    <dl class="module-runtime-facts"><div><dt>Container ID</dt><dd class="module-code">@(module.ContainerId ?? "Not assigned")</dd></div><div><dt>Storage path</dt><dd class="module-code">@(currentVersion?.StoragePath ?? "Not assigned")</dd></div></dl>
                </section>
                <section class="module-info-section" aria-labelledby="module-actions-heading">
                    <h2 id="module-actions-heading">Module actions</h2>
                    <div class="module-detail-actions">
                        <form method="post" asp-page="/ModulesPage/Detail" asp-page-handler="Start" asp-route-id="@module.Id">
                            <input type="hidden" name="moduleName" value="@module.ModuleName" />
                            <button class="module-button" type="submit" id="start-module-button" disabled="@(!canStart)" title="@(canStart ? "Start the module container" : $"Cannot start module while status is {ModuleStatusDisplay.StatusLabel(module.Status)}")"><i data-lucide="play" aria-hidden="true"></i><span>Start module</span></button>
                        </form>
                        <form method="post" asp-page="/ModulesPage/Detail" asp-page-handler="Stop" asp-route-id="@module.Id">
                            <input type="hidden" name="moduleName" value="@module.ModuleName" />
                            <button class="module-button" type="submit" id="stop-module-button" disabled="@(!canStop)" title="@(canStop ? "Stop the module container" : $"Cannot stop module while status is {ModuleStatusDisplay.StatusLabel(module.Status)}")"><i data-lucide="square" aria-hidden="true"></i><span>Stop module</span></button>
                        </form>
                        <button class="module-button @(canConfirmEndpoints ? "module-button-primary" : "")" type="button" id="confirm-endpoints-button" popovertarget="confirm-endpoints-dialog" disabled="@(!canConfirmEndpoints)" title="@(canConfirmEndpoints ? $"Review and confirm {pendingEndpoints.Count} pending endpoint(s)" : "No pending endpoints require confirmation")"><i data-lucide="check-circle-2" aria-hidden="true"></i><span>Confirm endpoints</span></button>
                        <button class="module-button" type="button" id="edit-module-button" popovertarget="edit-module-dialog" title="Edit the module name and description"><i data-lucide="pencil" aria-hidden="true"></i><span>Edit details</span></button>
                        <button class="module-button" type="button" id="update-files-button" popovertarget="update-files-dialog" title="Upload a new ZIP archive to patch this module"><i data-lucide="upload" aria-hidden="true"></i><span>Update files</span></button>
                        <button class="module-button" type="button" id="rollback-module-button" popovertarget="rollback-module-dialog" disabled="@(!canRollback)" title="@rollbackTitle"><i data-lucide="rotate-ccw" aria-hidden="true"></i><span>Rollback</span></button>
                        <button class="module-button module-button-danger" type="button" id="delete-module-button" popovertarget="delete-module-dialog" title="Delete this module and remove its container and files"><i data-lucide="trash-2" aria-hidden="true"></i><span>Delete module</span></button>
                    </div>
                </section>
            </aside>
        </div>

        <div class="module-dialog @(reopenEdit ? "module-dialog-open" : "")" id="edit-module-dialog" popover="@(reopenEdit ? null : "auto")" role="dialog" aria-labelledby="edit-module-heading">
            <div class="module-dialog-heading">
                <div class="modules-title"><h2 id="edit-module-heading">Edit module details</h2></div>
                @if (reopenEdit)
                {
                    <a class="module-icon-button" href="@detailUrl" aria-label="Close" title="Close"><i data-lucide="x" aria-hidden="true"></i></a>
                }
                else
                {
                    <button class="module-icon-button" type="button" popovertarget="edit-module-dialog" popovertargetaction="hide" aria-label="Close" title="Close"><i data-lucide="x" aria-hidden="true"></i></button>
                }
            </div>
            <form id="edit-module-form" method="post" asp-page="/ModulesPage/Detail" asp-page-handler="Edit" asp-route-id="@module.Id">
                @if (Model.EditError is { } editError)
                {
                    <div class="module-form-error" role="alert">
                        <strong>@editError.Title</strong> <span class="module-code">HTTP @editError.StatusCode</span>
                        <p>@editError.Description</p>
                    </div>
                }
                <fieldset class="module-form-fields" id="module-edit-fields">
                    <label>
                        <span>Module name <span class="required-mark">*</span></span>
                        <input name="ModuleName" value="@(Model.EditInput?.ModuleName ?? module.ModuleName)" required maxlength="100" placeholder="AnalyticsModule" autofocus />
                    </label>
                    <label>
                        <span>Description</span>
                        <textarea name="Description" rows="3" maxlength="500" placeholder="Optional description">@(Model.EditInput is not null ? Model.EditInput.Description : module.Description)</textarea>
                    </label>
                </fieldset>
                <div class="module-dialog-footer">
                    @if (reopenEdit)
                    {
                        <a class="module-button" href="@detailUrl">Cancel</a>
                    }
                    else
                    {
                        <button class="module-button" type="button" popovertarget="edit-module-dialog" popovertargetaction="hide">Cancel</button>
                    }
                    <button class="module-button module-button-primary" type="submit"><i data-lucide="check" aria-hidden="true"></i><span>Save changes</span></button>
                </div>
            </form>
        </div>

        <div class="module-dialog @(reopenUpdateFiles ? "module-dialog-open" : "")" id="update-files-dialog" popover="@(reopenUpdateFiles ? null : "auto")" role="dialog" aria-labelledby="update-files-heading">
            <div class="module-dialog-heading">
                <div class="modules-title"><h2 id="update-files-heading">Update module files</h2></div>
                @if (reopenUpdateFiles)
                {
                    <a class="module-icon-button" href="@detailUrl" aria-label="Close" title="Close"><i data-lucide="x" aria-hidden="true"></i></a>
                }
                else
                {
                    <button class="module-icon-button" type="button" popovertarget="update-files-dialog" popovertargetaction="hide" aria-label="Close" title="Close"><i data-lucide="x" aria-hidden="true"></i></button>
                }
            </div>
            <form id="update-files-form" method="post" asp-page="/ModulesPage/Detail" asp-page-handler="UpdateFiles" asp-route-id="@module.Id" enctype="multipart/form-data">
                @if (Model.UpdateFilesError is { } filesError)
                {
                    <div class="module-form-error" role="alert">
                        <strong>@filesError.Title</strong> <span class="module-code">HTTP @filesError.StatusCode</span>
                        <p>@filesError.Description</p>
                    </div>
                }
                <fieldset class="module-form-fields" id="module-update-files-fields">
                    <p class="module-dialog-description">Upload a new ZIP archive to deploy a new version of <strong>@module.ModuleName</strong> (current version: <span class="module-code">@module.CurrentVersion</span>). The archive will be scanned with high priority before replacing the active container.</p>
                    <label>
                        <span>Version <span class="required-mark">*</span></span>
                        <input name="Version" value="@Model.UpdateFilesInput?.Version" required maxlength="50" placeholder="v1.1.0" />
                    </label>
                    <label>
                        <span>Changelog</span>
                        <textarea name="Changelog" rows="2" maxlength="500" placeholder="Optional changelog for this version">@Model.UpdateFilesInput?.Changelog</textarea>
                    </label>
                    <span class="module-field-label">Module archive <span class="required-mark">*</span></span>
                    <label class="module-upload" id="module-update-upload-area" for="module-update-archive">
                        <i data-lucide="upload" aria-hidden="true"></i>
                        <strong>Choose a ZIP archive</strong>
                        <input id="module-update-archive" name="ModuleFile" type="file" accept=".zip,application/zip" aria-label="Module archive" required />
                    </label>
                </fieldset>
                <div class="module-dialog-footer">
                    @if (reopenUpdateFiles)
                    {
                        <a class="module-button" href="@detailUrl">Cancel</a>
                    }
                    else
                    {
                        <button class="module-button" type="button" popovertarget="update-files-dialog" popovertargetaction="hide">Cancel</button>
                    }
                    <button class="module-button module-button-primary" type="submit"><i data-lucide="upload" aria-hidden="true"></i><span>Update files</span></button>
                </div>
            </form>
        </div>

        <div class="module-dialog @(reopenRollback ? "module-dialog-open" : "")" id="rollback-module-dialog" popover="@(reopenRollback ? null : "auto")" role="dialog" aria-labelledby="rollback-module-heading" aria-describedby="rollback-module-description">
            <div class="module-dialog-heading">
                <div class="modules-title"><h2 id="rollback-module-heading">Rollback module version</h2></div>
                @if (reopenRollback)
                {
                    <a class="module-icon-button" href="@detailUrl" aria-label="Close" title="Close"><i data-lucide="x" aria-hidden="true"></i></a>
                }
                else
                {
                    <button class="module-icon-button" type="button" popovertarget="rollback-module-dialog" popovertargetaction="hide" aria-label="Close" title="Close"><i data-lucide="x" aria-hidden="true"></i></button>
                }
            </div>
            <form id="rollback-module-form" method="post" asp-page="/ModulesPage/Detail" asp-page-handler="Rollback" asp-route-id="@module.Id">
                @if (Model.RollbackError is { } rollbackError)
                {
                    <div class="module-form-error" role="alert">
                        <strong>@rollbackError.Title</strong> <span class="module-code">HTTP @rollbackError.StatusCode</span>
                        <p>@rollbackError.Description</p>
                    </div>
                }
                <input type="hidden" name="moduleName" value="@module.ModuleName" />
                <fieldset class="module-form-fields" id="module-rollback-fields">
                    <p class="module-dialog-description" id="rollback-module-description">Roll back <strong>@module.ModuleName</strong> from current version <span class="module-code">@module.CurrentVersion</span> to a previous version. This will rebuild and start the container from that version's files and restore its endpoints.</p>
                    <label>
                        <span>Target version <span class="required-mark">*</span></span>
                        <select name="version" id="rollback-version-select" required disabled="@(rollbackVersions.Count == 0)">
                            @foreach (var ver in rollbackVersions)
                            {
                                var isSelected = string.Equals(Model.RollbackVersion, ver.Version, StringComparison.Ordinal);
                                var optionLabel = string.IsNullOrWhiteSpace(ver.Changelog)
                                    ? $"{ver.Version} ({ver.ReleasedAtUtc.ToString("MMM d, yyyy HH:mm 'UTC'", CultureInfo.InvariantCulture)})"
                                    : $"{ver.Version} ({ver.ReleasedAtUtc.ToString("MMM d, yyyy HH:mm 'UTC'", CultureInfo.InvariantCulture)}) — {ver.Changelog}";
                                <option value="@ver.Version" selected="@isSelected">@optionLabel</option>
                            }
                        </select>
                    </label>
                </fieldset>
                <div class="module-dialog-footer">
                    @if (reopenRollback)
                    {
                        <a class="module-button" href="@detailUrl">Cancel</a>
                    }
                    else
                    {
                        <button class="module-button" type="button" popovertarget="rollback-module-dialog" popovertargetaction="hide">Cancel</button>
                    }
                    <button class="module-button module-button-primary" type="submit" disabled="@(rollbackVersions.Count == 0)"><i data-lucide="rotate-ccw" aria-hidden="true"></i><span>Rollback</span></button>
                </div>
            </form>
        </div>

        <div class="module-dialog @(reopenConfirmEndpoints ? "module-dialog-open" : "")" id="confirm-endpoints-dialog" popover="@(reopenConfirmEndpoints ? null : "auto")" role="dialog" aria-labelledby="confirm-endpoints-heading" aria-describedby="confirm-endpoints-description">
            <div class="module-dialog-heading">
                <div class="modules-title"><h2 id="confirm-endpoints-heading">Confirm pending endpoints</h2></div>
                @if (reopenConfirmEndpoints)
                {
                    <a class="module-icon-button" href="@detailUrl" aria-label="Close" title="Close"><i data-lucide="x" aria-hidden="true"></i></a>
                }
                else
                {
                    <button class="module-icon-button" type="button" popovertarget="confirm-endpoints-dialog" popovertargetaction="hide" aria-label="Close" title="Close"><i data-lucide="x" aria-hidden="true"></i></button>
                }
            </div>
            <form id="confirm-endpoints-form" method="post" asp-page="/ModulesPage/Detail" asp-page-handler="ConfirmEndpoints" asp-route-id="@module.Id">
                @if (Model.ConfirmEndpointsError is { } confirmError)
                {
                    <div class="module-form-error" role="alert">
                        <strong>@confirmError.Title</strong> <span class="module-code">HTTP @confirmError.StatusCode</span>
                        <p>@confirmError.Description</p>
                    </div>
                }
                <input type="hidden" name="moduleName" value="@module.ModuleName" />
                <fieldset class="module-form-fields" id="module-confirm-endpoints-fields">
                    <p class="module-dialog-description" id="confirm-endpoints-description">Review the pending endpoints for <strong>@module.ModuleName</strong>. Choose whether to activate each endpoint or remove it. Once all pending endpoints are resolved, the module container will be built and started automatically.</p>
                    @if (pendingEndpoints.Count == 0)
                    {
                        <p class="module-section-empty">No pending endpoints require confirmation.</p>
                    }
                    else
                    {
                        <div class="confirm-endpoints-list">
                            @for (var i = 0; i < pendingEndpoints.Count; i++)
                            {
                                var pendingEp = pendingEndpoints[i];
                                var methodUpper = pendingEp.HttpMethod.ToUpperInvariant();
                                var methodClass = methodUpper switch
                                {
                                    "GET" => "method-get",
                                    "POST" => "method-post",
                                    "PUT" or "PATCH" => "method-put",
                                    "DELETE" => "method-delete",
                                    _ => "method-other"
                                };
                                <div class="confirm-endpoint-item">
                                    <input type="hidden" name="decisions[@i].HttpMethod" value="@pendingEp.HttpMethod" />
                                    <input type="hidden" name="decisions[@i].EndpointPath" value="@pendingEp.EndpointPath" />
                                    <div class="endpoint-route">
                                        <span class="endpoint-method @methodClass">@methodUpper</span>
                                        <span class="module-code">/@module.BaseUrlPath.Trim('/')@pendingEp.EndpointPath</span>
                                    </div>
                                    <select name="decisions[@i].Action" aria-label="Action for @methodUpper @pendingEp.EndpointPath">
                                        <option value="activate" selected>Confirm (Activate)</option>
                                        <option value="remove">Remove endpoint</option>
                                    </select>
                                </div>
                            }
                        </div>
                    }
                </fieldset>
                <div class="module-dialog-footer">
                    @if (reopenConfirmEndpoints)
                    {
                        <a class="module-button" href="@detailUrl">Cancel</a>
                    }
                    else
                    {
                        <button class="module-button" type="button" popovertarget="confirm-endpoints-dialog" popovertargetaction="hide">Cancel</button>
                    }
                    <button class="module-button module-button-primary" type="submit" disabled="@(pendingEndpoints.Count == 0)"><i data-lucide="check" aria-hidden="true"></i><span>Confirm endpoints</span></button>
                </div>
            </form>
        </div>

        <div class="module-dialog @(reopenDelete ? "module-dialog-open" : "")" id="delete-module-dialog" popover="@(reopenDelete ? null : "auto")" role="dialog" aria-labelledby="delete-module-heading" aria-describedby="delete-module-description">
            <div class="module-dialog-heading">
                <div class="modules-title"><h2 id="delete-module-heading">Delete module?</h2></div>
                @if (reopenDelete)
                {
                    <a class="module-icon-button" href="@detailUrl" aria-label="Close" title="Close"><i data-lucide="x" aria-hidden="true"></i></a>
                }
                else
                {
                    <button class="module-icon-button" type="button" popovertarget="delete-module-dialog" popovertargetaction="hide" aria-label="Close" title="Close"><i data-lucide="x" aria-hidden="true"></i></button>
                }
            </div>
            <form id="delete-module-form" method="post" asp-page="/ModulesPage/Detail" asp-page-handler="Delete" asp-route-id="@module.Id">
                @if (Model.DeleteError is { } deleteError)
                {
                    <div class="module-form-error" role="alert">
                        <strong>@deleteError.Title</strong> <span class="module-code">HTTP @deleteError.StatusCode</span>
                        <p>@deleteError.Description</p>
                    </div>
                }
                <input type="hidden" name="moduleName" value="@module.ModuleName" />
                <div class="module-result-body">
                    <p id="delete-module-description">Permanently delete <strong>@module.ModuleName</strong> (<span class="module-code">@module.BaseUrlPath</span>)? This will stop and remove its container, delete its extracted files, and unregister all endpoints. This cannot be undone.</p>
                </div>
                <div class="module-dialog-footer">
                    @if (reopenDelete)
                    {
                        <a class="module-button" href="@detailUrl">Cancel</a>
                    }
                    else
                    {
                        <button class="module-button" type="button" popovertarget="delete-module-dialog" popovertargetaction="hide">Cancel</button>
                    }
                    <button class="module-button module-button-danger-solid" type="submit"><i data-lucide="trash-2" aria-hidden="true"></i><span>Delete module</span></button>
                </div>
            </form>
        </div>

        <span class="visually-hidden" id="module-copy-feedback" role="status"></span>
    }
</div>
@section Scripts {
    <script src="~/js/modules.js" asp-append-version="true"></script>
}