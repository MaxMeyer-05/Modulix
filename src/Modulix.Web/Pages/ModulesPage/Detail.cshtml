@page "/modules/{id:guid}"
@model DetailModel
@using System.Globalization
@{
    var module = Model.Module;
    ViewData["Title"] = module?.ModuleName ?? "Module not found";
}
@section Styles {
    <link rel="stylesheet" href="~/css/modules.css" asp-append-version="true" />
}
<div class="modules-page">
    <a class="module-back-link" asp-page="/ModulesPage/Index"><i data-lucide="arrow-left" aria-hidden="true"></i><span>All modules</span></a>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="modules-error" role="alert">
            <i data-lucide="circle-alert" aria-hidden="true"></i>
            <div>
                <strong>Module request failed</strong>
                <div asp-validation-summary="All"></div>
            </div>
        </div>
    }

    @if (Model.Feedback is { } feedback)
    {
        <div class="queue-feedback @(feedback.IsSuccess ? "queue-feedback-success" : "modules-error")" role="status">
            <i data-lucide="@(feedback.IsSuccess ? "check-circle-2" : "circle-alert")" aria-hidden="true"></i>
            <div>
                <strong>@feedback.Title</strong>
                <p>@feedback.Description</p>
            </div>
        </div>
    }

    @if (module is null)
    {
        <div class="module-empty-state">
            <i data-lucide="box" aria-hidden="true"></i><h1>Module not found</h1>
        </div>
    }
    else
    {
        @if (module.Status == Modulix.Client.Models.Enums.ModuleStatus.Failed)
        {
            <div class="modules-error module-failed-banner" role="alert">
                <i data-lucide="triangle-alert" aria-hidden="true"></i>
                <div class="module-failed-banner-content">
                    <div>
                        <strong>Module container failed</strong>
                        <p>The container for <strong>@module.ModuleName</strong> failed to start or exited unexpectedly. Restart the module or upload a patched archive.</p>
                    </div>
                </div>
            </div>
        }
        @if (Model.HasPendingEndpoints)
        {
            <section class="module-discrepancy-banner" id="module-discrepancy-report" role="status" aria-labelledby="discrepancy-report-heading">
                <div class="module-discrepancy-banner-header">
                    <div class="module-discrepancy-banner-title">
                        <i data-lucide="clock-3" aria-hidden="true"></i>
                        <div>
                            <strong id="discrepancy-report-heading">Endpoint discrepancy report</strong>
                            <p>The scanner detected differences between the expected and discovered sub-endpoints for <strong>@module.ModuleName</strong>. Review each pending endpoint before the container is built and started.</p>
                        </div>
                    </div>
                    @if (Model.CanConfirmEndpoints)
                    {
                        <button class="module-button module-button-compact module-button-primary" type="button" popovertarget="confirm-endpoints-dialog">
                            <i data-lucide="check-circle-2" aria-hidden="true"></i><span>Confirm endpoints (@Model.PendingEndpoints.Count)</span>
                        </button>
                    }
                </div>
                @if (Model.HasDiscrepancyReport)
                {
                    <div class="module-discrepancy-summary">
                        @if (Model.ExtraDiscrepancyEndpoints.Count > 0)
                        {
                            <div class="module-discrepancy-group" data-discrepancy-group="extra">
                                <div class="module-discrepancy-group-header">
                                    <span class="module-badge badge-pending"><span aria-hidden="true"></span>Extra endpoints (@Model.ExtraDiscrepancyEndpoints.Count)</span>
                                    <span class="module-discrepancy-hint">Discovered by scanner, not specified by user (Pending confirmation)</span>
                                </div>
                                <ul class="module-discrepancy-routes">
                                    @foreach (var ep in Model.ExtraDiscrepancyEndpoints)
                                    {
                                        var methodUpper = ep.HttpMethod.ToUpperInvariant();
                                        var methodClass = methodUpper switch
                                        {
                                            "GET" => "method-get",
                                            "POST" => "method-post",
                                            "PUT" or "PATCH" => "method-put",
                                            "DELETE" => "method-delete",
                                            _ => "method-other"
                                        };
                                        <li>
                                            <span class="endpoint-method @methodClass">@methodUpper</span>
                                            <span class="module-code">/@module.BaseUrlPath.Trim('/')@ep.EndpointPath</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        @if (Model.MissingDiscrepancyEndpoints.Count > 0)
                        {
                            <div class="module-discrepancy-group" data-discrepancy-group="missing">
                                <div class="module-discrepancy-group-header">
                                    <span class="module-badge badge-failed"><span aria-hidden="true"></span>Missing endpoints (@Model.MissingDiscrepancyEndpoints.Count)</span>
                                    <span class="module-discrepancy-hint">Specified by user, not found by scanner (Pending confirmation)</span>
                                </div>
                                <ul class="module-discrepancy-routes">
                                    @foreach (var ep in Model.MissingDiscrepancyEndpoints)
                                    {
                                        var methodUpper = ep.HttpMethod.ToUpperInvariant();
                                        var methodClass = methodUpper switch
                                        {
                                            "GET" => "method-get",
                                            "POST" => "method-post",
                                            "PUT" or "PATCH" => "method-put",
                                            "DELETE" => "method-delete",
                                            _ => "method-other"
                                        };
                                        <li>
                                            <span class="endpoint-method @methodClass">@methodUpper</span>
                                            <span class="module-code">/@module.BaseUrlPath.Trim('/')@ep.EndpointPath</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        @if (Model.MatchedDiscrepancyEndpoints.Count > 0)
                        {
                            <div class="module-discrepancy-group" data-discrepancy-group="matched">
                                <div class="module-discrepancy-group-header">
                                    <span class="module-badge badge-running"><span aria-hidden="true"></span>Matched endpoints (@Model.MatchedDiscrepancyEndpoints.Count)</span>
                                    <span class="module-discrepancy-hint">Specified by user and verified by scanner (Active)</span>
                                </div>
                                <ul class="module-discrepancy-routes">
                                    @foreach (var ep in Model.MatchedDiscrepancyEndpoints)
                                    {
                                        var methodUpper = ep.HttpMethod.ToUpperInvariant();
                                        var methodClass = methodUpper switch
                                        {
                                            "GET" => "method-get",
                                            "POST" => "method-post",
                                            "PUT" or "PATCH" => "method-put",
                                            "DELETE" => "method-delete",
                                            _ => "method-other"
                                        };
                                        <li>
                                            <span class="endpoint-method @methodClass">@methodUpper</span>
                                            <span class="module-code">/@module.BaseUrlPath.Trim('/')@ep.EndpointPath</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }
            </section>
        }
        <header class="module-detail-header">
            <div class="module-detail-title">
                <span class="module-symbol module-symbol-large"><i data-lucide="box" aria-hidden="true"></i></span>
                <div><div class="modules-title"><h1>@module.ModuleName</h1></div><p>@module.Description</p></div>
            </div>
            <span class="module-badge badge-@ModuleStatusDisplay.StatusClass(module.Status)"><span aria-hidden="true"></span>@ModuleStatusDisplay.StatusLabel(module.Status)</span>
        </header>
        <div class="module-detail-layout">
            <div class="module-detail-main">
                <section class="module-info-section" aria-labelledby="module-info-heading">
                    <h2 id="module-info-heading">Module information</h2>
                    <dl class="module-detail-facts">
                        <div class="module-fact-wide"><dt>Module ID</dt><dd class="module-copy-value"><span class="module-code">@module.Id</span><button class="module-icon-button" type="button" data-copy="@module.Id" aria-label="Copy module ID" title="Copy module ID"><i data-lucide="copy" aria-hidden="true"></i></button></dd></div>
                        <div><dt>Base path</dt><dd class="module-code">@module.BaseUrlPath</dd></div>
                        <div><dt>Container port</dt><dd>@module.ContainerPort</dd></div>
                        <div><dt>Current version</dt><dd class="module-code">@module.CurrentVersion</dd></div>
                        <div><dt>Created</dt><dd>@module.CreatedAtUtc.ToString("MMM d, yyyy 'at' HH:mm 'UTC'", CultureInfo.InvariantCulture)</dd></div>
                    </dl>
                </section>
                <partial name="_DetailEndpoints" model="Model" />
                <partial name="_DetailVersions" model="Model" />
            </div>
            <aside class="module-detail-aside">
                <section class="module-info-section" aria-labelledby="module-runtime-heading">
                    <h2 id="module-runtime-heading">Runtime &amp; storage</h2>
                    <dl class="module-runtime-facts">
                        <div><dt>Container ID</dt><dd class="module-code">@(module.ContainerId ?? "Not assigned")</dd></div>
                        <div><dt>Storage path</dt><dd class="module-code">@(Model.CurrentVersion?.StoragePath ?? "Not assigned")</dd></div>
                        @if (Model.ShowContainerStats)
                        {
                            <div><dt>CPU usage</dt><dd class="module-code" data-stat="cpu">@Model.FormattedCpuUsage</dd></div>
                            <div><dt>Memory usage</dt><dd class="module-code" data-stat="memory">@Model.FormattedMemoryUsage</dd></div>
                            <div><dt>Uptime</dt><dd class="module-code" data-stat="uptime" data-uptime-seconds="@((int)Math.Round(Model.ModuleStats?.UptimeSeconds ?? 0))">@Model.FormattedUptime</dd></div>
                        }
                        @if (Model.ModuleStats is { IsRunning: false } stoppedStats && !string.IsNullOrWhiteSpace(module.ContainerId))
                        {
                            <div><dt>Last exit code</dt><dd class="module-code" data-stat="exit-code">@stoppedStats.ExitCode</dd></div>
                        }
                    </dl>
                </section>
                <section class="module-info-section" aria-labelledby="module-actions-heading">
                    <h2 id="module-actions-heading">Module actions</h2>
                    <div class="module-detail-actions">
                        @if (Model.CanStart)
                        {
                            <form method="post" asp-page="/ModulesPage/Detail" asp-page-handler="Start" asp-route-id="@module.Id">
                                <input type="hidden" name="moduleName" value="@module.ModuleName" />
                                <button class="module-button" type="submit" id="start-module-button" title="Start the module container"><i data-lucide="play" aria-hidden="true"></i><span>Start module</span></button>
                            </form>
                        }
                        @if (Model.CanStop)
                        {
                            <form method="post" asp-page="/ModulesPage/Detail" asp-page-handler="Stop" asp-route-id="@module.Id">
                                <input type="hidden" name="moduleName" value="@module.ModuleName" />
                                <button class="module-button" type="submit" id="stop-module-button" title="Stop the module container"><i data-lucide="square" aria-hidden="true"></i><span>Stop module</span></button>
                            </form>
                        }
                        @if (Model.CanConfirmEndpoints)
                        {
                            <button class="module-button module-button-primary" type="button" id="confirm-endpoints-button" popovertarget="confirm-endpoints-dialog" title="Review and confirm @Model.PendingEndpoints.Count pending endpoint(s)"><i data-lucide="check-circle-2" aria-hidden="true"></i><span>Confirm endpoints</span></button>
                        }
                        <button class="module-button" type="button" id="edit-module-button" popovertarget="edit-module-dialog" title="Edit the module name and description"><i data-lucide="pencil" aria-hidden="true"></i><span>Edit details</span></button>
                        <button class="module-button" type="button" id="update-files-button" popovertarget="update-files-dialog" title="Upload a new ZIP archive to patch this module"><i data-lucide="upload" aria-hidden="true"></i><span>Update files</span></button>
                        @if (Model.CanRollback)
                        {
                            <button class="module-button" type="button" id="rollback-module-button" popovertarget="rollback-module-dialog" title="@Model.RollbackTitle"><i data-lucide="rotate-ccw" aria-hidden="true"></i><span>Rollback</span></button>
                        }
                        <button class="module-button module-button-danger" type="button" id="delete-module-button" popovertarget="delete-module-dialog" title="Delete this module and remove its container and files"><i data-lucide="trash-2" aria-hidden="true"></i><span>Delete module</span></button>
                    </div>
                </section>
            </aside>
        </div>

        <partial name="_DetailDialogs" model="Model" />

        <span class="visually-hidden" id="module-copy-feedback" role="status"></span>
    }
</div>
@section Scripts {
    <script src="~/js/modules.js" asp-append-version="true"></script>
}
