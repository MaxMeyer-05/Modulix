@model DetailModel
@{
    var module = Model.Module!;
    var dialogHeader = new DialogHeaderModel("delete-module-heading", "Delete module?", "trash-2");
}
<dialog class="dialog dialog--sm dialog--danger" id="delete-module-dialog" data-open-on-load="@(Model.ReopenDelete ? "true" : "false")" closedby="closerequest" aria-labelledby="@dialogHeader.HeadingId" aria-describedby="delete-module-description">
    <partial name="_DialogHeader" model="dialogHeader" />
    <form class="dialog-layout" id="delete-module-form" method="post" asp-page="/ModulesPage/Detail" asp-page-handler="Delete" asp-route-id="@module.Id">
        <div class="dialog-body">
            @if (Model.DeleteError is { } deleteError)
            {
                <div class="module-form-error" role="alert">
                    <strong>@deleteError.Title</strong> <span class="module-code">HTTP @deleteError.StatusCode</span>
                    <p>@deleteError.Description</p>
                </div>
            }
            <input type="hidden" name="moduleName" value="@module.ModuleName" />
            <p class="dialog-description" id="delete-module-description">Permanently delete <strong>@module.ModuleName</strong> (<span class="module-code">@module.BaseUrlPath</span>)? This will stop and remove its container, delete its extracted files, and unregister all endpoints. This cannot be undone.</p>
        </div>
        <div class="dialog-footer">
            <partial name="_DialogCancelButton" />
            <button class="ui-button ui-button-danger" type="submit"><i data-lucide="trash-2" aria-hidden="true"></i><span>Delete module</span></button>
        </div>
    </form>
</dialog>
