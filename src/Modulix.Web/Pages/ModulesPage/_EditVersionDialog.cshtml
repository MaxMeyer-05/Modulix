@model DetailModel
@{
    var module = Model.Module!;
    var editVersionId = Model.OrderedVersions.FirstOrDefault(version => version.Version == Model.EditVersionTarget)?.Id;
    var dialogHeader = new DialogHeaderModel("edit-version-heading", "Edit version metadata", "pencil");
}
<dialog class="dialog dialog--md" id="edit-version-dialog" data-open-on-load="@(Model.ReopenEditVersion ? "true" : "false")" data-dialog-return-focus="@(editVersionId.HasValue ? $"edit-version-{editVersionId}" : null)" closedby="closerequest" aria-labelledby="@dialogHeader.HeadingId">
    <partial name="_DialogHeader" model="dialogHeader" />
    <form class="dialog-layout" id="edit-version-form" method="post" asp-page="/ModulesPage/Detail" asp-page-handler="EditVersion" asp-route-id="@module.Id">
        <div class="dialog-body">
            @if (Model.EditVersionError is { } editVersionError)
            {
                <div class="module-form-error" role="alert">
                    <strong>@editVersionError.Title</strong> <span class="module-code">HTTP @editVersionError.StatusCode</span>
                    <p>@editVersionError.Description</p>
                </div>
            }
            <input type="hidden" name="moduleName" value="@module.ModuleName" />
            <input type="hidden" name="originalVersion" id="edit-version-original" value="@Model.EditVersionTarget" />
            <fieldset class="module-form-fields" id="module-edit-version-fields">
                <label>
                    <span>Version <span class="required-mark">*</span></span>
                    <input name="Version" id="edit-version-name" value="@(Model.EditVersionInput?.Version ?? Model.EditVersionTarget)" required maxlength="50" placeholder="v1.0.0" />
                </label>
                <label>
                    <span>Changelog</span>
                    <textarea name="Changelog" id="edit-version-changelog" rows="3" maxlength="500" placeholder="Optional changelog for this version">@Model.EditVersionInput?.Changelog</textarea>
                </label>
            </fieldset>
        </div>
        <div class="dialog-footer">
            <partial name="_DialogCancelButton" />
            <button class="ui-button ui-button-primary" type="submit"><i data-lucide="check" aria-hidden="true"></i><span>Save changes</span></button>
        </div>
    </form>
</dialog>
