<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Modulix.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Modulix.Web.styles.css" asp-append-version="true" />
</head>
<body class="modulix-app">
    <div class="app-shell" id="app-shell">
        <aside class="sidebar" aria-label="Main navigation">
            <div class="sidebar-header">
                <a class="sidebar-brand" asp-page="/Index" title="Modulix Dashboard" aria-label="Modulix Dashboard">
                    <i data-lucide="box" aria-hidden="true"></i>
                    <span class="sidebar-label">MODULIX</span>
                </a>
                <button class="sidebar-toggle" id="sidebar-toggle" type="button"
                        aria-controls="sidebar-navigation" aria-expanded="true"
                        aria-label="Hide menu" title="Hide menu">
                    <i data-lucide="chevrons-left" aria-hidden="true"></i>
                </button>
            </div>
            <nav class="sidebar-navigation" id="sidebar-navigation" aria-label="Sections">
                <a class="sidebar-link active" asp-page="/Index" aria-current="page" title="Dashboard">
                    <i data-lucide="house" aria-hidden="true"></i>
                    <span class="sidebar-label">Dashboard</span>
                </a>
                <span class="sidebar-link is-unavailable" aria-disabled="true" title="Modules: not yet available">
                    <i data-lucide="layout-grid" aria-hidden="true"></i>
                    <span class="sidebar-label">Modules</span>
                </span>
                <span class="sidebar-link is-unavailable" aria-disabled="true" title="Docker containers: not yet available">
                    <i data-lucide="container" aria-hidden="true"></i>
                    <span class="sidebar-label">Docker containers</span>
                </span>
                <span class="sidebar-link is-unavailable" aria-disabled="true" title="Scan queue: not yet available">
                    <i data-lucide="list-checks" aria-hidden="true"></i>
                    <span class="sidebar-label">Scan queue</span>
                </span>
                <span class="sidebar-link is-unavailable" aria-disabled="true" title="API endpoints: not yet available">
                    <i data-lucide="link" aria-hidden="true"></i>
                    <span class="sidebar-label">API endpoints</span>
                </span>
                <span class="sidebar-link is-unavailable" aria-disabled="true" title="Settings: not yet available">
                    <i data-lucide="settings" aria-hidden="true"></i>
                    <span class="sidebar-label">Settings</span>
                </span>
            </nav>
        </aside>
        <div class="app-workspace">
            <header class="topbar" aria-label="Workspace toolbar">
                <div class="workspace-search" role="search">
                    <div class="search-field">
                        <i data-lucide="search" aria-hidden="true"></i>
                        <input id="workspace-search" type="search" placeholder="Search modules, endpoints..."
                               aria-label="Search" aria-controls="search-results" autocomplete="off" />
                        <button class="topbar-icon search-clear" id="search-clear" type="button"
                                aria-label="Clear search" title="Clear search" hidden>
                            <i data-lucide="x" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="topbar-panel search-results" id="search-results" aria-label="Search results" hidden>
                        <ul id="search-result-list"></ul>
                        <p id="search-empty" class="panel-empty" role="status" hidden>No results found.</p>
                    </div>
                </div>
                <div class="notifications">
                    <button class="topbar-icon" id="notifications-toggle" type="button"
                            aria-label="Notifications" title="Notifications"
                            aria-controls="notifications-panel" aria-expanded="false">
                        <i data-lucide="bell" aria-hidden="true"></i>
                    </button>
                    <section class="topbar-panel notifications-panel" id="notifications-panel"
                             aria-labelledby="notifications-heading" hidden>
                        <h2 id="notifications-heading">Notifications</h2>
                        <div class="notifications-empty">
                            <i data-lucide="bell" aria-hidden="true"></i>
                            <p>No notifications yet.</p>
                        </div>
                    </section>
                </div>
            </header>
            <main role="main" class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/lucide.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
