{
 "Serilog": {
  "MinimumLevel": {
   "Default": "Warning",
   "Override": {
    "Modulix.Web": "Information",
    "Microsoft.Hosting.Lifetime": "Information"
   }
  },
  "WriteTo": [
   {
    "Name": "Console",
    "Args": {
     "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}|[{Level:u3}]|{Scope}|{SourceContext:l}|{Message:lj}|{NewLine}{Exception}"
    }
   },
   {
    "Name": "File",
    "Args": {
     "path": "logs/log-.log",
     "rollingInterval": "Day",
     "retainedFileCountLimit": 30,
     "shared": true,
     "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}|[{Level:u3}]|{Scope}|{SourceContext:l}|{Message:lj}|{NewLine}{Exception}"
    }
   }
  ],
  "Enrich": [ "FromLogContext" ]
 },
 "Authorization": {
  "Authority": "<authority-url>",
  "Service": {
   "ClientId": "modulix_Service",
   "ClientSecret": "<service-account-client-secret>"
  },
  "Client": {
   "ClientId": "modulix_Client",
   "ClientSecret": "<client-secret>"
  }
 },
 "ModulixApi": {
  "BaseUrl": "PLACEHOLDER_FOR_MODULIX_API_BASE_URL"
 }
}
