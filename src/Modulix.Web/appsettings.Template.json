{
 "Serilog": {
  "MinimumLevel": {
   "Default": "Warning"
  },
  "WriteTo": [
   {
    "Name": "Console",
    "Args": {
     "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}|[{Level:u3}]|{Scope}|{SourceContext:l}|{Message:lj}|{NewLine}{Exception}"
    }
   },
   {
    "Name": "File",
    "Args": {
     "path": "logs/log-.log",
     "rollingInterval": "Day",
     "retainedFileCountLimit": 30,
     "shared": true,
     "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}|[{Level:u3}]|{Scope}|{SourceContext:l}|{Message:lj}|{NewLine}{Exception}"
    }
   }
  ],
  "Enrich": [ "FromLogContext" ]
 },
 "Keycloak": {
  "Issuer": "PLACEHOLDER_FOR_ISSUER",
  "MetadataAddress": "PLACEHOLDER_FOR_METADATA_ADDRESS",
  "ClientId": "PLACEHOLDER_FOR_CLIENT_ID",
  "ClientSecret": "PLACEHOLDER_FOR_CLIENT_SECRET"
 }
}
