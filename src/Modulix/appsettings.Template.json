{
 "ConnectionStrings": {
  "ServerDatabase": "Data Source=modulix.db"
 },
 "Modulix": {
  "StorageBasePath": "storage/modules",
  "MaximumArchiveEntryCount": 1000,
  "MaximumArchiveUncompressedBytes": 536870912,
  "NetworkName": "modulix-network",
  "BaseImage": "mcr.microsoft.com/dotnet/aspnet:10.0",
  "ScannerImage": "modulix-scanner:latest",
  "MaxConcurrentScans": 4
 },
 "Serilog": {
  "MinimumLevel": {
   "Default": "Warning"
  },
  "WriteTo": [
   {
    "Name": "Console",
    "Args": {
     "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}|[{Level:u3}]|{Scope}|{SourceContext:l}|{Message:lj}|{NewLine}{Exception}"
    }
   },
   {
    "Name": "File",
    "Args": {
     "path": "logs/log-.log",
     "rollingInterval": "Day",
     "retainedFileCountLimit": 30,
     "shared": true,
     "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}|[{Level:u3}]|{Scope}|{SourceContext:l}|{Message:lj}|{NewLine}{Exception}"
    }
   }
  ],
  "Enrich": [ "FromLogContext" ]
 },
 "Keycloak": {
  "Issuer": "PLACEHOLDER_FOR_ISSUER",
  "Audience": "PLACEHOLDER_FOR_AUDIENCE",
  "MetadataAddress": "PLACEHOLDER_FOR_METADATA_ADDRESS"
 }
}
