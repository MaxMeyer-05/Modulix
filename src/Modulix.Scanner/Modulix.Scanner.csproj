<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>Modulix - Scanner</AssemblyTitle>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Modulix - Scanner</Title>
    <Authors>Max Meyer</Authors>
    <Product>Modulix</Product>
    <Description>CLI scanner tool for the Modulix framework.</Description>
    <RepositoryUrl>https://github.com/MaxMeyer-05/Modulix</RepositoryUrl>
    <Version>1.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
