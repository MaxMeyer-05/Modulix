{
 "ConnectionStrings": {
  "ServerDatabase": "Data Source=modulix.db"
 },
 "Serilog": {
  "MinimumLevel": {
   "Default": "Warning"
  },
  "WriteTo": [
   {
    "Name": "Console",
    "Args": {
     "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}|[{Level:u3}]|{Scope}|{SourceContext:l}|{Message:lj}|{NewLine}{Exception}"
    }
   },
   {
    "Name": "File",
    "Args": {
     "path": "logs/log-.log", // replace with your desired log file path
     "rollingInterval": "Day",
     "retainedFileCountLimit": 30,
     "shared": true,
     "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}|[{Level:u3}]|{Scope}|{SourceContext:l}|{Message:lj}|{NewLine}{Exception}"
    }
   }
  ],
  "Enrich": [ "FromLogContext" ]
 },
 "Jwt": {
  "Issuer": "Modulix",
  "Audience": "Modulix-Clients",
  "AccessTokenLifetimeMinutes": 60
 }
}
